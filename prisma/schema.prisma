enum SocialPublicationType {
  PUBLICATION
  ARTICLE
}

model SocialFollowerSnapshot {
  id             Int      @id @default(autoincrement())
  platformId     Int
  date           DateTime
  followersCount Int
  recordedById   Int?
  notes          String?
  createdAt      DateTime @default(now())

  platform   SocialPlatform @relation(fields: [platformId], references: [id])
  recordedBy User?          @relation("SocialSnapshotRecordedBy", fields: [recordedById], references: [id])

  @@unique([platformId, date])
}

// ── RETARDS & DÉPARTS PRÉCIPITÉS ────────────────────────────────────────────
// Justification d'une journée de retard d'arrivée / départ anticipé non
// couverte automatiquement : un administrateur ou manager relie la journée à
// une demande de congé approuvée ou à une activité CRM « Visite chantier /
// Sortie en clientèle / Courses » traitée, ce qui la marque « justifiée ».
model AttendanceDelayJustification {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  date           DateTime  @db.Date
  leaveRequestId Int?
  crmActivityId  Int?      @unique // une activité ne justifie qu'une seule journée
  justified      Boolean   @default(false)
  justifiedById  Int?
  justifiedAt    DateTime?
  // Tolérance : marquage manuel (SUPER_ADMIN/ADMIN/MANAGER), sans demande de
  // congé ni activité CRM liée, plafonné par `hr.lateness.toleranceMinutes`
  // (Paramètres → Retards & Départs précipités). Exclut la journée du cumul
  // non justifié (donc du KPI LATE_EARLY_DEPARTURE_HOURS), comme `justified`.
  tolerated      Boolean   @default(false)
  toleratedById  Int?
  toleratedAt    DateTime?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id])
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id])
  crmActivity  CrmActivity?  @relation(fields: [crmActivityId], references: [id])
  justifiedBy  User?         @relation("AttendanceDelayJustifiedBy", fields: [justifiedById], references: [id])
  toleratedBy  User?         @relation("AttendanceDelayToleratedBy", fields: [toleratedById], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
}

// ── INNOVATIONS IT (Module 16) ──────────────────────────────────────────────
// Fiche d'innovation IT portée par un employé, validée en 3 phases successives
// (énoncé/description 15% → démonstration/test 35%, cumulé 50% → validation
// finale/intégration 50%, cumulé 100% = « mise en œuvre »). Alimente le KPI
// IT_INNOVATIONS_IMPLEMENTED (source IT_INNOVATION, Module 14). Un rejet de
// phase n'est pas définitif : le porteur corrige et la resoumet.
model ItInnovation {
  id          Int    @id @default(autoincrement())
  uuid        String @unique @default(cuid())
  reference   String @unique // Ex: INNOV-2026-0001
  title       String
  employeeId  Int // porteur de l'innovation
  createdById Int? // utilisateur ayant créé la fiche (audit, sans relation Prisma)

  status   ItInnovationStatus @default(PHASE1_EN_ATTENTE)
  progress Int                @default(0) // 0 / 15 / 50 / 100

  // Phase 1 — Énoncé et description (15%)
  phase1Description     String    @db.Text
  phase1ValidatedById   Int?
  phase1ValidatedAt     DateTime?
  phase1RejectedAt      DateTime?
  phase1RejectionReason String?   @db.Text

  // Phase 2 — Démonstration et validation de test (+35%, cumulé 50%)
  phase2Description     String?   @db.Text
  phase2SubmittedAt     DateTime?
  phase2ValidatedById   Int?
  phase2ValidatedAt     DateTime?
  phase2RejectedAt      DateTime?
  phase2RejectionReason String?   @db.Text

  // Phase 3 — Validation finale et intégration (+50%, cumulé 100%)
  phase3Description     String?   @db.Text
  phase3SubmittedAt     DateTime?
  phase3ValidatedById   Int?
  phase3ValidatedAt     DateTime?
  phase3RejectedAt      DateTime?
  phase3RejectionReason String?   @db.Text

  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employee    Employee   @relation(fields: [employeeId], references: [id])
  attachments Document[] @relation("ItInnovationAttachments")

  @@index([employeeId])
  @@index([status])
}

enum ItInnovationStatus {
  PHASE1_EN_ATTENTE // soumise, en attente de validation phase 1
  PHASE1_REJETEE // phase 1 rejetée, en révision par le porteur
  PHASE2_EN_COURS // phase 1 validée (15%), le porteur complète la phase 2
  PHASE2_EN_ATTENTE // phase 2 soumise, en attente de validation
  PHASE2_REJETEE // phase 2 rejetée, en révision
  PHASE3_EN_COURS // phase 2 validée (50%), le porteur complète la phase 3
  PHASE3_EN_ATTENTE // phase 3 soumise, en attente de validation
  PHASE3_REJETEE // phase 3 rejetée, en révision
  VALIDEE // phase 3 validée (100%) = innovation mise en œuvre
}

// ── MOTEUR DE DEVIS DE CONSTRUCTION (Module 17) ─────────────────────────────
// Génère un devis quantitatif et estimatif de construction à partir des
// caractéristiques d'un projet (type de bâtiment, standing, surfaces,
// pièces…), en faisant correspondre ces caractéristiques à une bibliothèque
// d'ouvrages (recettes de ressources) regroupés en 22 lots de travaux, via un
// moteur de coefficients paramétrable par (type de bâtiment × standing).
// Méthode de prix : déboursé sec → frais de chantier → frais généraux →
// marge = prix de vente HT (cf. ConstructionEstimate.markupMode). Le prix
// d'une ressource est lu à chaud à chaque génération (ConstructionResource
// .unitPrice) — une variation de prix se répercute automatiquement sur tous
// les ouvrages concernés ; seules les lignes déjà générées (ConstructionEstimateLine
// / ConstructionEstimateResourceLine) sont des snapshots figés dans le temps.
// Niveau 2 se convertit en un Quote réel (module Devis existant) : les 22 lots
// se projettent 1-pour-1 sur QuoteItem.category (regroupement/sous-totaux déjà
// gérés par quoteTemplate.ts, aucune duplication de cette logique ici).
// Phase 1 : Niveau 1 (estimation rapide) + Niveau 2 (devis détaillé). Le
// planning prévisionnel, la courbe de décaissement et la reprise manuelle des
// quantités (Niveau 3) sont reportés à une phase 2 — les champs nécessaires
// sont réservés (ConstructionEstimateLine.overriddenQuantity/isOverridden/
// overrideNote) mais non câblés à l'IU dans cette phase.

enum ConstructionBuildingType {
  VILLA_BASSE
  VILLA_DUPLEX
  VILLA_TRIPLEX
  MAISON_ECONOMIQUE
  IMMEUBLE_R_PLUS
  BUREAU
  COMMERCE
  ENTREPOT_HANGAR
  AUTRE
}

enum ConstructionStanding {
  ECONOMIQUE
  STANDARD
  MOYEN_STANDING
  HAUT_STANDING
  LUXE
}

enum ConstructionRoofType {
  DALLE_PLEINE
  CHARPENTE_BOIS_TOLE
  CHARPENTE_BOIS_TUILE
  CHARPENTE_METALLIQUE_BAC
  MIXTE_DALLE_CHARPENTE
}

enum ConstructionJoineryType {
  ALUMINIUM_STANDARD
  ALUMINIUM_VITRAGE_TEINTE
  PVC
  BOIS_MASSIF
  METALLIQUE
  MIXTE_ALU_BOIS
}

enum ConstructionFlooringType {
  CHAPE_LISSEE
  CARRELAGE_GRES_STANDARD
  CARRELAGE_GRES_CERAME
  GRANITO
  MARBRE
  PARQUET_BOIS
  MIXTE
}

enum ConstructionAcType {
  AUCUNE
  VENTILATION_SEULE
  SPLIT_PARTIEL
  SPLIT_TOUTES_PIECES
  GAINABLE_CENTRALISE
}

enum ConstructionKitchenType {
  NUE
  SIMPLE_PAILLASSE
  EQUIPEE_STANDARD
  EQUIPEE_HAUT_DE_GAMME
}

enum ConstructionTerrainType {
  PLAT
  LEGERE_PENTE
  FORTE_PENTE
  MARECAGEUX_REMBLAI
  ROCHEUX
}

enum ConstructionSanitationType {
  FOSSE_SEPTIQUE_PUISARD
  FOSSE_TOUTES_EAUX_EPANDAGE
  MICRO_STATION
  RACCORDEMENT_RESEAU_COLLECTIF
  AUCUN
}

// Ventilation « Niveau 1 » demandée par l'utilisateur : gros œuvre / second
// œuvre / électricité / plomberie / finitions / VRD / aménagements.
enum ConstructionLotPhase {
  GROS_OEUVRE
  SECOND_OEUVRE
  ELECTRICITE
  PLOMBERIE
  FINITIONS
  VRD
  AMENAGEMENTS
}

enum ConstructionResourceType {
  MATERIAU
  MAIN_OEUVRE
  TRANSPORT
  MATERIEL
  SOUS_TRAITANCE
}

enum ConstructionPrecisionLevel {
  NIVEAU_1 // estimation rapide
  NIVEAU_2 // devis estimatif détaillé
  NIVEAU_3 // DQE avec reprise manuelle des quantités (phase ultérieure)
}

enum ConstructionProjectStatus {
  BROUILLON
  ESTIME
  DEVIS_EMIS
  ARCHIVE
}

enum ConstructionEstimateStatus {
  BROUILLON
  VALIDE
  CONVERTI
  OBSOLETE
}

// CASCADE (défaut, usage BTP) : DS ×(1+frais chantier) ×(1+frais généraux)
// ×(1+marge). ADDITIF : DS ×(1 + frais chantier + frais généraux + marge).
enum ConstructionMarkupMode {
  CASCADE
  ADDITIF
}

// ── Référentiels / catalogues ───────────────────────────────────────────────

// Les 22 lots de travaux (chapitres du DQE). `phase` alimente la ventilation
// du Niveau 1. Se projette 1-pour-1 sur QuoteItem.category à la conversion.
model ConstructionLot {
  id          Int                  @id @default(autoincrement())
  uuid        String               @unique @default(cuid())
  code        String               @unique // LOT01 … LOT22
  numero      Int // 1 … 22 (affichage « LOT 05 »)
  label       String // « Maçonnerie »
  phase       ConstructionLotPhase @default(GROS_OEUVRE)
  description String?              @db.Text
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  workItems ConstructionWorkItem[]

  @@index([phase])
  @@index([numero])
}

// Catalogue des coefficients/ratios utilisés par le registre de formules
// (construction-formulas.ts). Même principe que KpiDefinition : un nouveau
// coefficient = une ligne ici + une entrée dans le registre TS, jamais une
// migration.
model ConstructionRatioDefinition {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(cuid())
  code         String    @unique // slug stable : COEF_REVETEMENT_SOL, PRISES_PAR_CHAMBRE…
  label        String
  category     String? // regroupement d'affichage : « Géométrie », « Électricité »…
  unit         String? // ratio, %, nb, m, ml, m², m³, kg/m³ (libellé libre)
  defaultValue Decimal   @default(0) @db.Decimal(12, 4) // valeur de repli si absente du profil
  minValue     Decimal?  @db.Decimal(12, 4) // garde-fou de saisie
  maxValue     Decimal?  @db.Decimal(12, 4)
  description  String?   @db.Text
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  values ConstructionRatioValue[]

  @@index([category])
}

// Référentiel « famille » de ressources (même principe que CatalogCategory) —
// la valeur retenue est stockée en clair sur ConstructionResource.family.
model ConstructionResourceFamily {
  id        Int       @id @default(autoincrement())
  label     String    @unique // « Ciments & liants », « Aciers », « Main d'œuvre »…
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Localité et coefficient de prix générique appliqué aux ressources qui n'ont
// pas de variante explicite pour cette ville (ConstructionResourcePriceVariant
// reste la dérogation ponctuelle quand le prix réel est connu).
model ConstructionLocality {
  id               Int       @id @default(autoincrement())
  label            String    @unique // « Abidjan », « Bouaké », « Korhogo »…
  region           String?
  priceCoefficient Decimal   @default(1.000) @db.Decimal(6, 3) // 1.000 = référence (Abidjan)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  projects      ConstructionProject[]
  priceVariants ConstructionResourcePriceVariant[]
}

// ── Bordereau des prix de base (price book) ─────────────────────────────────

// La ressource et son PRIX COURANT — source de vérité unique, lue à chaud par
// le moteur à chaque génération. Un changement de unitPrice n'affecte aucune
// estimation déjà générée (snapshot figé dans ConstructionEstimateLine /
// ConstructionEstimateResourceLine), seulement les générations futures.
model ConstructionResource {
  id                Int                      @id @default(autoincrement())
  uuid              String                   @unique @default(cuid())
  code              String                   @unique // MAT.CIMENT.CPJ35, MO.MACON, TR.LIVRAISON…
  label             String // « Ciment CPJ 35 — sac de 50 kg »
  type              ConstructionResourceType @default(MATERIAU)
  family            String? // libellé libre (cf. ConstructionResourceFamily)
  unit              String // sac, m³, kg, u, ml, m², h, t, forfait (cf. KpiUnit)
  quality           String? // « CPJ 35 », « HA Fe500 », « 1er choix »…
  unitPrice         Decimal                  @default(0) @db.Decimal(15, 2)
  priceDate         DateTime? // date de validité du prix courant
  supplierName      String? // fournisseur de référence du prix courant
  referenceCity     String? // ville de référence du prix courant (ex: Abidjan)
  priceIsIndicative Boolean                  @default(true) // prix issu du seed de démarrage, à valider
  description       String?                  @db.Text
  notes             String?                  @db.Text
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?

  components    ConstructionWorkItemComponent[]
  priceVariants ConstructionResourcePriceVariant[]
  priceHistory  ConstructionResourcePriceHistory[]

  @@index([type])
  @@index([family])
  @@index([isActive])
}

// Dérogation ponctuelle de prix par ville — pas de matrice combinatoire
// ressource × ville : seules les exceptions connues sont enregistrées ici, le
// cas général retombe sur ConstructionLocality.priceCoefficient.
model ConstructionResourcePriceVariant {
  id           Int       @id @default(autoincrement())
  resourceId   Int
  localityId   Int
  unitPrice    Decimal   @db.Decimal(15, 2)
  supplierName String?
  quality      String?
  priceDate    DateTime?
  note         String?   @db.Text
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  resource ConstructionResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  locality ConstructionLocality @relation(fields: [localityId], references: [id])

  @@unique([resourceId, localityId])
  @@index([localityId])
}

// Journal d'audit en ajout seul — jamais lu par le moteur de calcul (P1),
// uniquement consultatif (« historique du prix », graphique de variation).
model ConstructionResourcePriceHistory {
  id            Int      @id @default(autoincrement())
  resourceId    Int
  localityId    Int? // null = prix de référence ; sinon variante ville
  previousPrice Decimal? @db.Decimal(15, 2)
  unitPrice     Decimal  @db.Decimal(15, 2)
  variationPct  Decimal? @db.Decimal(8, 2) // calculé à l'écriture, pour les graphiques
  effectiveDate DateTime @default(now())
  supplierName  String?
  quality       String?
  source        String? // « Relevé fournisseur », « Facture », « Estimation »…
  note          String?  @db.Text
  changedById   Int?
  createdAt     DateTime @default(now())

  resource  ConstructionResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  changedBy User?                @relation("ConstructionPriceChangedBy", fields: [changedById], references: [id])

  @@index([resourceId])
  @@index([effectiveDate])
}

// ── Bibliothèque d'ouvrages ──────────────────────────────────────────────────

// L'ouvrage composé (« recette ») — ex : « Mur en agglos de 15 ». Sa quantité
// pour un projet donné est soit calculée via formulaCode (registre TS), soit
// fixe (fixedQuantity), soit exprimée en % du total des autres lignes
// (percentOfTotalPct — utilisé pour les lots « Installation de chantier » et
// « Nettoyage & réception »).
model ConstructionWorkItem {
  id                 Int       @id @default(autoincrement())
  uuid               String    @unique @default(cuid())
  code               String    @unique // MAC.MUR.AGGLO15, BA.SEMELLE, REV.CARRELAGE.SOL…
  lotId              Int
  designation        String    @db.Text // libellé complet tel qu'affiché sur le devis
  description        String?   @db.Text
  unit               String // m², m³, ml, kg, u, forfait (cf. KpiUnit)
  formulaCode        String? // clé du registre de formules TS ; null → fixedQuantity
  fixedQuantity      Decimal?  @db.Decimal(12, 3)
  quantityMultiplier Decimal   @default(1) @db.Decimal(10, 4) // scinde une même formule entre 2 ouvrages
  applicabilityRule  Json? // règle déclarative d'inclusion conditionnelle (null = toujours applicable)
  percentOfTotalPct  Decimal?  @db.Decimal(6, 3) // ouvrage tarifé en % du total des autres lignes
  deboursSecOverride Decimal?  @db.Decimal(15, 4) // court-circuite la recette si renseigné
  sortOrder          Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  lot        ConstructionLot                 @relation(fields: [lotId], references: [id])
  components ConstructionWorkItemComponent[]

  @@index([lotId])
  @@index([formulaCode])
  @@index([isActive])
}

// La recette d'un ouvrage : quantité de ressource consommée par unité
// d'ouvrage, pertes incluses. Somme pondérée par le prix courant de chaque
// ressource = déboursé sec unitaire de l'ouvrage.
model ConstructionWorkItemComponent {
  id              Int      @id @default(autoincrement())
  workItemId      Int
  resourceId      Int
  quantityPerUnit Decimal  @db.Decimal(14, 5) // qté ressource / unité d'ouvrage (ex: 12,5 agglos / m²)
  wastageRate     Decimal  @default(0) @db.Decimal(5, 2) // % de pertes/casse
  note            String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workItem ConstructionWorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  resource ConstructionResource @relation(fields: [resourceId], references: [id])

  @@unique([workItemId, resourceId])
  @@index([resourceId])
}

// ── Moteur de coefficients ───────────────────────────────────────────────────

// Profil de coefficients par (type de bâtiment × standing) — même mécanique
// que PerformanceWeightProfile. Pas de soft delete : la contrainte unique sur
// (buildingType, standing) empêcherait sinon de recréer le couple ; sans
// risque, les estimations passées conservent un ratioSnapshot JSON figé.
model ConstructionRatioProfile {
  id           Int                      @id @default(autoincrement())
  uuid         String                   @unique @default(cuid())
  name         String // « Villa basse — Haut standing »
  buildingType ConstructionBuildingType
  standing     ConstructionStanding
  description  String?                  @db.Text
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  values ConstructionRatioValue[]

  @@unique([buildingType, standing])
  @@index([buildingType])
}

model ConstructionRatioValue {
  id                Int     @id @default(autoincrement())
  profileId         Int
  ratioDefinitionId Int
  value             Decimal @db.Decimal(12, 4)
  note              String?

  profile         ConstructionRatioProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ratioDefinition ConstructionRatioDefinition @relation(fields: [ratioDefinitionId], references: [id])

  @@unique([profileId, ratioDefinitionId])
  @@index([ratioDefinitionId])
}

// ── Projet & estimations (transactionnel) ───────────────────────────────────

// Les caractéristiques d'un projet de construction, saisies une fois et
// réutilisées pour générer autant d'estimations (versions) que nécessaire.
model ConstructionProject {
  id        Int                       @id @default(autoincrement())
  uuid      String                    @unique @default(cuid())
  reference String                    @unique // Ex: PC-2026-0001
  nom       String
  status    ConstructionProjectStatus @default(BROUILLON)

  // Rattachements optionnels
  clientId   Int?
  prospectId Int?
  terrainId  Int?
  projectId  Int? // rattachement au module Projets (opération de chantier)
  agentId    Int?

  // Caractéristiques du bâtiment
  buildingType      ConstructionBuildingType @default(VILLA_BASSE)
  standing          ConstructionStanding     @default(MOYEN_STANDING)
  levels            Int                      @default(1) // niveaux bâtis, RDC compris (1 = plain-pied)
  roomCount         Int                      @default(1) // nombre de pièces (« 5 pièces »)
  livingRoomCount   Int                      @default(1) // séjours / salons
  bedroomCount      Int                      @default(0) // chambres
  bathroomCount     Int                      @default(0) // SDB (avec baignoire)
  showerRoomCount   Int                      @default(0) // SDE (douche)
  wcCount           Int                      @default(0) // WC indépendants
  surfaceHabitable  Decimal                  @db.Decimal(10, 2) // surface utile
  surfaceConstruite Decimal?                 @db.Decimal(10, 2) // si null → dérivée
  kitchenType       ConstructionKitchenType  @default(EQUIPEE_STANDARD)

  // Second œuvre / finitions
  roofType            ConstructionRoofType     @default(DALLE_PLEINE)
  joineryType         ConstructionJoineryType  @default(ALUMINIUM_STANDARD) // menuiserie extérieure
  interiorJoineryType ConstructionJoineryType? // menuiserie intérieure (null → BOIS_MASSIF)
  flooringType        ConstructionFlooringType @default(CARRELAGE_GRES_STANDARD)
  acType              ConstructionAcType       @default(SPLIT_PARTIEL)
  acRoomCount         Int? // pièces climatisées (null → dérivé de acType)
  hasFalseCeiling     Boolean                  @default(false)

  // Terrain, localisation, VRD
  terrainType              ConstructionTerrainType    @default(PLAT)
  terrainSurface           Decimal?                   @db.Decimal(10, 2)
  localityId               Int?
  ville                    String?
  commune                  String?
  quartier                 String?
  sanitationType           ConstructionSanitationType @default(FOSSE_SEPTIQUE_PUISARD)
  hasWaterConnection       Boolean                    @default(true)
  hasElectricityConnection Boolean                    @default(true)

  // Extérieurs
  fenceLength          Decimal? @db.Decimal(10, 2) // clôture (ml)
  fenceHeight          Decimal? @db.Decimal(5, 2) // hauteur (m), défaut applicatif 2,00
  gateCount            Int      @default(0) // portails
  hasPool              Boolean  @default(false)
  poolSurface          Decimal? @db.Decimal(10, 2)
  hasExteriorLayout    Boolean  @default(false) // aménagements extérieurs
  exteriorPavedSurface Decimal? @db.Decimal(10, 2) // dallage / pavage (m²)
  hasLandscaping       Boolean  @default(false) // espaces verts

  // Paramètres économiques (surcharges facultatives — sinon AppSetting/défaut de code)
  fraisChantierPct Decimal?                @db.Decimal(5, 2)
  fraisGenerauxPct Decimal?                @db.Decimal(5, 2)
  margePct         Decimal?                @db.Decimal(5, 2)
  tvaPct           Decimal?                @db.Decimal(5, 2)
  markupMode       ConstructionMarkupMode?

  description String?   @db.Text
  notes       String?   @db.Text
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client    Client?                @relation(fields: [clientId], references: [id])
  prospect  Prospect?              @relation(fields: [prospectId], references: [id])
  terrain   Terrain?               @relation(fields: [terrainId], references: [id])
  project   Project?               @relation(fields: [projectId], references: [id])
  agent     User?                  @relation("ConstructionProjectAgent", fields: [agentId], references: [id])
  createdBy User?                  @relation("ConstructionProjectCreatedBy", fields: [createdById], references: [id])
  locality  ConstructionLocality?  @relation(fields: [localityId], references: [id])
  estimates ConstructionEstimate[]

  @@index([clientId])
  @@index([prospectId])
  @@index([status])
  @@index([buildingType, standing])
  @@index([createdById])
}

// Une génération d'estimation = une ligne (versionnée par projet). Fige les
// paramètres de prix et les totaux du moment ; les lignes détaillées et le
// quantitatif de ressources sont dans les tables associées.
model ConstructionEstimate {
  id             Int                        @id @default(autoincrement())
  uuid           String                     @unique @default(cuid())
  reference      String                     @unique // Ex: EST-2026-0001
  projectId      Int
  version        Int                        @default(1)
  precisionLevel ConstructionPrecisionLevel @default(NIVEAU_2)
  status         ConstructionEstimateStatus @default(BROUILLON)
  label          String? // « v2 — après arbitrage carrelage »

  // Profil de coefficients utilisé (scalaire, snapshot — pas de FK)
  ratioProfileId   Int?
  ratioProfileName String?
  ratioSnapshot    Json? // { CODE_RATIO: valeur, … } effectivement appliqué
  localityId       Int? // scalaire — localité de prix retenue
  localityLabel    String?

  // Paramètres de prix figés
  markupMode       ConstructionMarkupMode @default(CASCADE)
  fraisChantierPct Decimal                @default(0) @db.Decimal(5, 2)
  fraisGenerauxPct Decimal                @default(0) @db.Decimal(5, 2)
  margePct         Decimal                @default(0) @db.Decimal(5, 2)
  tvaPct           Decimal                @default(0) @db.Decimal(5, 2)
  puRoundingStep   Int                    @default(1) // arrondi du PU en FCFA (1, 5, 10, 100)

  // Totaux figés
  totalDeboursMateriaux  Decimal  @default(0) @db.Decimal(15, 2)
  totalDeboursMainOeuvre Decimal  @default(0) @db.Decimal(15, 2)
  totalDeboursTransport  Decimal  @default(0) @db.Decimal(15, 2)
  totalDeboursAutres     Decimal  @default(0) @db.Decimal(15, 2)
  totalDeboursSec        Decimal  @default(0) @db.Decimal(15, 2)
  totalFraisChantier     Decimal  @default(0) @db.Decimal(15, 2)
  totalFraisGeneraux     Decimal  @default(0) @db.Decimal(15, 2)
  totalMarge             Decimal  @default(0) @db.Decimal(15, 2)
  totalHT                Decimal  @default(0) @db.Decimal(15, 2)
  totalTVA               Decimal  @default(0) @db.Decimal(15, 2)
  totalTTC               Decimal  @default(0) @db.Decimal(15, 2)
  prixMoyenM2            Decimal? @db.Decimal(15, 2)

  // Spécifique Niveau 1 (fourchette)
  toleranceRangePct Decimal? @db.Decimal(5, 2) // ex: 12,00 → ±12 %
  budgetMin         Decimal? @db.Decimal(15, 2)
  budgetMax         Decimal? @db.Decimal(15, 2)

  // Qualité du calcul
  coveragePct Decimal? @db.Decimal(5, 2) // % de lots couverts par la bibliothèque
  warnings    Json? // string[] : ratios manquants, prix à 0…

  // Conversion en devis (scalaire, sans FK — cf. Quote.convertedConventionId)
  quoteId        Int?
  quoteReference String?
  convertedAt    DateTime?

  generatedById Int?
  generatedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  project       ConstructionProject                @relation(fields: [projectId], references: [id])
  generatedBy   User?                              @relation("ConstructionEstimateGeneratedBy", fields: [generatedById], references: [id])
  lines         ConstructionEstimateLine[]
  resourceLines ConstructionEstimateResourceLine[]

  @@unique([projectId, version])
  @@index([projectId])
  @@index([precisionLevel])
  @@index([status])
}

// Le DQE figé — une ligne = un ouvrage instancié pour cette estimation.
model ConstructionEstimateLine {
  id         Int @id @default(autoincrement())
  estimateId Int

  // Lot (figé, scalaire)
  lotId     Int?
  lotCode   String
  lotLabel  String // devient QuoteItem.category à la conversion
  lotNumero Int                  @default(0)
  lotPhase  ConstructionLotPhase @default(GROS_OEUVRE)

  // Ouvrage (figé, scalaire — traçabilité seule, pas de FK)
  workItemId   Int?
  workItemCode String?
  designation  String  @db.Text
  unit         String?

  // Quantités
  computedQuantity   Decimal  @default(0) @db.Decimal(14, 3) // sortie du moteur
  overriddenQuantity Decimal? @db.Decimal(14, 3) // réservé Niveau 3 (non câblé en Phase 1)
  isOverridden       Boolean  @default(false) // réservé Niveau 3
  overrideNote       String?  @db.Text // réservé Niveau 3
  quantity           Decimal  @default(0) @db.Decimal(14, 3) // quantité effective retenue

  // Décomposition du prix (figée)
  deboursMateriaux   Decimal @default(0) @db.Decimal(15, 4)
  deboursMainOeuvre  Decimal @default(0) @db.Decimal(15, 4)
  deboursTransport   Decimal @default(0) @db.Decimal(15, 4)
  deboursAutres      Decimal @default(0) @db.Decimal(15, 4)
  deboursSecUnitaire Decimal @default(0) @db.Decimal(15, 4)
  fraisChantierUnit  Decimal @default(0) @db.Decimal(15, 4)
  fraisGenerauxUnit  Decimal @default(0) @db.Decimal(15, 4)
  margeUnit          Decimal @default(0) @db.Decimal(15, 4)
  prixUnitaireHT     Decimal @default(0) @db.Decimal(15, 2)
  montantHT          Decimal @default(0) @db.Decimal(15, 2)

  // Traçabilité du calcul
  formulaCode  String?
  formulaTrace String? @db.Text // « 180,00 m² × 1,10 (COEF_REVETEMENT_SOL) = 198,00 m² »

  order     Int      @default(0)
  createdAt DateTime @default(now())

  estimate ConstructionEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@index([workItemId])
  @@index([lotCode])
}

// Agrégation des besoins en ressources sur l'ensemble de l'estimation — un
// seul modèle sert les deux livrables « Quantitatif des matériaux »
// (resourceType = MATERIAU/MATERIEL) et « Besoin en main d'œuvre »
// (resourceType = MAIN_OEUVRE).
model ConstructionEstimateResourceLine {
  id         Int @id @default(autoincrement())
  estimateId Int

  resourceId    Int? // scalaire, traçabilité seule
  resourceCode  String
  resourceLabel String
  resourceType  ConstructionResourceType @default(MATERIAU)
  family        String?
  unit          String?

  quantityNette Decimal @default(0) @db.Decimal(16, 3) // hors pertes
  quantity      Decimal @default(0) @db.Decimal(16, 3) // pertes incluses
  unitPrice     Decimal @default(0) @db.Decimal(15, 2) // prix figé au moment du calcul
  montant       Decimal @default(0) @db.Decimal(15, 2)

  order     Int      @default(0)
  createdAt DateTime @default(now())

  estimate ConstructionEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@unique([estimateId, resourceCode])
  @@index([estimateId, resourceType])
}
