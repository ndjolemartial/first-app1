generator client {
  provider      = "prisma-client-js"
  // Moteurs de requête embarqués pour le packaging multi-plateformes.
  // « native » = OS de build courant ; les autres couvrent les cibles de
  // distribution. debian-openssl-1.1.x : requis pour le script autonome de
  // relances (run-reminders-once.ts) déployé sur un NAS Synology DSM (OpenSSL
  // 1.1.x sur le paquet Node.js DSM 7.x, distinct du 3.0.x d'un Debian récent).
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── UTILISATEURS ──────────────────────────────────────────────

model User {
  id                     Int                 @id @default(autoincrement())
  uuid                   String              @unique @default(cuid())
  reference              String              @unique // Ex: USR-2026-0001
  matricule              String
  firstName              String
  lastName               String
  email                  String              @unique
  login                  String?             @unique
  password               String
  role                   UserRole            @default(AGENT)
  isActive               Boolean             @default(true)
  avatar                 String?
  phone                  String?
  mobile                 String?
  fonction               String?
  // Nom commercial / d'usage affiché sur les documents (devis…) en tant
  // qu'émetteur. À défaut, on retombe sur « nom + prénom ».
  nomCommercial          String?
  // Signature personnelle (HTML) ajoutée à tout email envoyé depuis « Envoyer
  // un message » (module Communication) sans modèle ou avec un modèle de type
  // « manuel » (CommTemplate.usageType = MANUEL) — quelle que soit l'entité
  // ciblée. Les modèles « auto » et les relances automatiques conservent la
  // signature SMTP (AppSetting email.signature).
  messageSignature       String?             @db.Text
  idNumber               String?
  civilite               CiviliteType?
  statutConjugal         StatutConjugalType?
  hireDate               DateTime?
  cnpsNumber             String?
  residence              String?
  // Préférence de thème graphique : DEFAULT | AFRIKIMMO | DARK_GOLD
  theme                  String              @default("DEFAULT")
  // Comptes de trésorerie par défaut, préremplis dans le champ « Compte » du
  // formulaire de nouvelle opération selon le sens choisi (entrée / sortie).
  defaultAccountEntreeId Int?
  defaultAccountSortieId Int?
  lastLoginAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?

  activities                  CrmActivity[]                      @relation("ActivityAssignedTo")
  createdActivities           CrmActivity[]                      @relation("ActivityCreatedBy")
  conventions                 Convention[]                       @relation("AgentConventions")
  notes                       Note[]
  timelineEvents              EntityTimelineEvent[]
  archivedEntities            ArchiveRecord[]                    @relation("ArchivedBy")
  restoredEntities            ArchiveRecord[]                    @relation("RestoredBy")
  commissions                 Commission[]                       @relation("UserCommissions")
  commissionsPaid             Commission[]                       @relation("CommissionPaidBy")
  commissionsCancelled        Commission[]                       @relation("CommissionCancelledBy")
  treasuryOperations          TreasuryOperation[]                @relation("TreasuryCreatedBy")
  linkedBankAccounts          BankAccount[]                      @relation("BankAccountLinkedUser")
  bankAccountViews            BankAccountViewer[]
  defaultAccountEntree        BankAccount?                       @relation("UserDefaultEntreeAccount", fields: [defaultAccountEntreeId], references: [id])
  defaultAccountSortie        BankAccount?                       @relation("UserDefaultSortieAccount", fields: [defaultAccountSortieId], references: [id])
  uploadedDocuments           Document[]                         @relation("DocumentUploadedBy")
  linkedDocuments             Document[]                         @relation("DocumentLinkedUser")
  documentAuditLogs           DocumentAuditLog[]                 @relation("DocumentAuditUser")
  managedBudgetLines          BudgetLine[]                       @relation("BudgetLineManager")
  closedBudgets               Budget[]                           @relation("BudgetClosedBy")
  assignedProspects           Prospect[]                         @relation("ProspectAssignedTo")
  createdProspects            Prospect[]                         @relation("ProspectCreatedBy")
  assignedClients             Client[]                           @relation("ClientAssignedTo")
  assignedReferrers           BusinessReferrer[]                 @relation("ReferrerAssignedTo")
  attestationsEmitted         Attestation[]                      @relation("AttestationEmittedBy")
  communicationsSent          Communication[]                    @relation("CommunicationSentBy")
  quotesAsAgent               Quote[]                            @relation("QuoteAgent")
  quotesCreated               Quote[]                            @relation("QuoteCreatedBy")
  ownedDocumentFolders        DocumentFolder[]                   @relation("FolderOwner")
  documentFolderAccesses      DocumentFolderAccess[]             @relation("FolderAccessUser")
  employee                    Employee?                          @relation("UserEmployee")
  leaveDecisions              LeaveRequest[]                     @relation("LeaveDecidedBy")
  forecastExpensesCreated     ForecastExpense[]                  @relation("ForecastExpenseCreatedBy")
  forecastExpensesSettled     ForecastExpense[]                  @relation("ForecastExpenseSettledBy")
  visitorsCreated             Visitor[]                          @relation("VisitorCreatedBy")
  callsCreated                PhoneCall[]                        @relation("PhoneCallCreatedBy")
  perfEvaluationsAsEvaluator  PerformanceEvaluation[]            @relation("PerfEvaluator")
  perfRankingSnapshots        PerformanceRankingSnapshot[]       @relation("PerfRankingGeneratedBy")
  socialPlatformsResponsible  SocialPlatform[]                   @relation("SocialPlatformResponsible")
  socialPublicationsAuthored  SocialPublication[]                @relation("SocialPublicationAuthor")
  socialSnapshotsRecorded     SocialFollowerSnapshot[]           @relation("SocialSnapshotRecordedBy")
  delayJustificationsMade     AttendanceDelayJustification[]     @relation("AttendanceDelayJustifiedBy")
  delayTolerationsMade        AttendanceDelayJustification[]     @relation("AttendanceDelayToleratedBy")
  constructionProjectsAgent   ConstructionProject[]              @relation("ConstructionProjectAgent")
  constructionProjectsCreated ConstructionProject[]              @relation("ConstructionProjectCreatedBy")
  constructionEstimates       ConstructionEstimate[]             @relation("ConstructionEstimateGeneratedBy")
  constructionPriceChanges    ConstructionResourcePriceHistory[] @relation("ConstructionPriceChangedBy")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ACCOUNTANT
  ASSISTANTE_DIRECTION
  AGENT
  AGENT_TECHNIQUE
  RH
  READONLY
}

// ── PROSPECTS ─────────────────────────────────────────────────

model Prospect {
  id           Int            @id @default(autoincrement())
  uuid         String         @unique @default(cuid())
  reference    String         @unique // Ex: PSP-2026-0001
  firstName    String
  lastName     String
  civilite     CiviliteType?
  email        String?
  phone        String?
  mobile       String?
  source       ProspectSource @default(PROSPECTION)
  status       ProspectStatus @default(NOUVEAU)
  budget       Decimal?       @db.Decimal(15, 2)
  notes        String?        @db.Text
  assignedToId Int?
  createdById  Int?
  convertedAt  DateTime?
  clientId     Int?           @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  client               Client?               @relation(fields: [clientId], references: [id])
  assignedTo           User?                 @relation("ProspectAssignedTo", fields: [assignedToId], references: [id])
  createdBy            User?                 @relation("ProspectCreatedBy", fields: [createdById], references: [id])
  activities           CrmActivity[]
  tags                 ProspectTag[]
  documents            Document[]
  quotes               Quote[]
  calls                PhoneCall[]
  communications       Communication[]
  constructionProjects ConstructionProject[]
}

enum ProspectSource {
  SITE_WEB_AFRIKIMMO
  RECOMMENDATION
  TELEPHONE
  RESEAUX_SOCIAUX
  EMAIL
  CONTACT_PERSONNEL
  AUTRE
  PROSPECTION
}

enum ProspectStatus {
  NOUVEAU
  CONTACTE
  QUALIFIE
  ENVOI_PROPOSITION
  NEGOCIATION_EN_COURS
  CONVERTI
  PERDU
}

// ── CLIENTS ───────────────────────────────────────────────────

model Client {
  id                   Int                @id @default(autoincrement())
  uuid                 String             @unique @default(cuid())
  reference            String             @unique // Ex: CLI-2026-0001
  type                 ClientType         @default(INDIVIDUEL)
  firstName            String?
  lastName             String?
  civilite             CiviliteType       @default(Monsieur)
  statutConjugal       StatutConjugalType @default(CELIBATAIRE)
  entreprise           String?
  registre_de_commerce String?
  compte_contribuable  String?
  // Entreprise — informations complémentaires
  website              String? // Site web de l'entreprise
  companyActivity      String? // Activités de l'entreprise
  // Entreprise — représentant légal
  legalRepFirstName    String?
  legalRepLastName     String?
  legalRepPhone        String?
  legalRepIdNumber     String?
  legalRepIdTypeId     Int?
  email                String?
  phone                String?
  mobile               String?
  address              String?
  commune              String?
  city                 String?
  postalCode           String?
  country              String             @default("CI")
  nationality          String?
  profession           String? // Profession (client particulier)
  birthDate            DateTime?
  birthPlace           String?
  idNumber             String?
  idTypeId             Int?
  fatherFirstName      String?
  fatherLastName       String?
  motherFirstName      String?
  motherLastName       String?
  notes                String?            @db.Text
  isActive             Boolean            @default(true)
  status               ClientStatus       @default(ACTIF)
  // Refus de relances automatiques par canal (politique de communication).
  smsOptOut            Boolean            @default(false)
  emailOptOut          Boolean            @default(false)
  // Affectation : un client peut être suivi par un utilisateur interne ET
  // apporté par un référent externe (BusinessReferrer) ; les deux coexistent.
  assignedToId         Int?
  referrerId           Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?

  prospect              Prospect?
  assignedTo            User?                 @relation("ClientAssignedTo", fields: [assignedToId], references: [id])
  referrer              BusinessReferrer?     @relation("ClientReferrer", fields: [referrerId], references: [id])
  idType                IdDocumentType?       @relation("ClientIdType", fields: [idTypeId], references: [id])
  legalRepIdType        IdDocumentType?       @relation("ClientLegalRepIdType", fields: [legalRepIdTypeId], references: [id])
  conventions           Convention[]          @relation("ConventionClient")
  secondaryConventions  Convention[]          @relation("ConventionSecondaryClient")
  documents             Document[]
  activities            CrmActivity[]
  invoices              Invoice[]
  installments          SaleInstallment[]
  terrains              Terrain[]
  properties            Property[]            @relation("ClientProperties")
  attestations          Attestation[]         @relation("AttestationClient")
  attestationsSecondary Attestation[]         @relation("AttestationSecondaryClient")
  projects              Project[]
  communications        Communication[]
  quotes                Quote[]
  calls                 PhoneCall[]
  constructionProjects  ConstructionProject[]
}

enum ClientType {
  INDIVIDUEL
  ENTREPRISE
}

enum ClientStatus {
  ACTIF
  INACTIF
  VIP
  SUSPENDU
}

enum CiviliteType {
  Monsieur
  Madame
  Mademoiselle
}

enum StatutConjugalType {
  CELIBATAIRE
  MARIEE
  CONCUBINAGE
  DIVORCE // Divorcé(e)
  VEUF // Veuf/Veuve
}

// ── PROPRIÉTAIRES ─────────────────────────────────────────────

model Owner {
  id                  Int           @id @default(autoincrement())
  uuid                String        @unique @default(cuid())
  type                ClientType    @default(INDIVIDUEL)
  // Particulier
  firstName           String?
  lastName            String?
  civilite            CiviliteType?
  nationality         String? // Nationalité (particulier)
  idNumber            String? // Numéro pièce d'identité (particulier)
  idTypeId            Int? // Type de pièce d'identité (particulier)
  // Entreprise
  companyName         String?
  registreCommerce    String? // Numéro registre de commerce
  legalRepFirstName   String? // Prénom représentant légal
  legalRepLastName    String? // Nom représentant légal
  legalRepPhone       String? // Contact représentant légal
  legalRepIdNumber    String? // Numéro pièce d'identité représentant légal
  legalRepIdTypeId    Int? // Type de pièce d'identité du représentant légal
  // Commun
  email               String?
  phone               String?
  mobile              String?
  address             String?
  city                String?
  postalCode          String?
  country             String        @default("CI")
  bankIban            String?
  bankBic             String?
  compte_contribuable String?
  notes               String?       @db.Text
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  properties     Property[]
  terrains       Terrain[]
  documents      Document[]
  activities     CrmActivity[]
  projects       Project[]
  communications Communication[]
  idType         IdDocumentType? @relation("OwnerIdType", fields: [idTypeId], references: [id])
  legalRepIdType IdDocumentType? @relation("OwnerLegalRepIdType", fields: [legalRepIdTypeId], references: [id])
}

// ── LOTISSEMENTS ───────────────────────────────────────────────

model Lotissement {
  id                        Int               @id @default(autoincrement())
  uuid                      String            @unique @default(cuid())
  reference                 String            @unique // Ex: LOT-2024-0001
  nom                       String
  commune                   String?
  quartier                  String?
  ville                     String
  pays                      String            @default("CI")
  surface                   Decimal?          @db.Decimal(12, 2) // Surface totale en m²
  nombreParcelles           Int?
  promoteur                 String?
  statut                    LotissementStatus @default(EN_COURS_LOTISSEMENT)
  // Titre administratif sollicité (référentiel paramétrable) et numéro du
  // titre obtenu lorsqu'il est délivré.
  titleTypeId               Int?
  titleNumber               String?
  description               String?           @db.Text
  latitude                  Float?
  longitude                 Float?
  // Frais de démarches ACD : montant standard applicable lorsqu'un client confie
  // les démarches ACD à l'entreprise sur un terrain de ce lotissement. Sert de
  // pré-remplissage sur chaque terrain — la valeur retenue reste modifiable au
  // niveau du terrain (négociation, remise…).
  fraisDemarchesAcdStandard Decimal?          @db.Decimal(15, 2)
  // Grille de prix de vente par modalité de paiement (clé = PaymentModalites,
  // valeur = montant FCFA). Héritée par les terrains du lotissement, surchargeable
  // au niveau de chaque terrain. Ex : { "CASH": 5000000, "SUR_6_MOIS": 5500000 }
  salePriceTiers            Json?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  deletedAt                 DateTime?

  terrains           Terrain[]
  documents          Document[]
  activities         CrmActivity[]
  projects           Project[]
  treasuryOperations TreasuryOperation[]
  quotes             Quote[]
  titleType          LotissementTitleType? @relation(fields: [titleTypeId], references: [id])
}

enum LotissementStatus {
  EN_COURS_LOTISSEMENT
  EN_COURS
  OUVERT
  PARTIELLEMENT_VENDU
  COMPLET
  FERME
}

// ── PROGRAMMES IMMOBILIERS ─────────────────────────────────────

/// Programme immobilier : opération de promotion regroupant des biens
/// (et éventuellement des terrains) mis à la vente ou en location.
model ProgrammeImmobilier {
  id                  Int             @id @default(autoincrement())
  uuid                String          @unique @default(cuid())
  reference           String          @unique // Ex: PROG-2026-0001
  nom                 String
  type                ProgrammeType   @default(RESIDENTIEL)
  promoteur           String?
  commune             String?
  quartier            String?
  ville               String
  pays                String          @default("CI")
  surface             Decimal?        @db.Decimal(12, 2) // Surface totale en m²
  nombreLogements     Int?
  dateDebut           DateTime? // Date de démarrage du programme
  dateLivraisonPrevue DateTime? // Date de livraison prévisionnelle
  statut              ProgrammeStatus @default(EN_PROJET)
  description         String?         @db.Text
  latitude            Float?
  longitude           Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  properties         Property[]
  terrains           Terrain[]
  documents          Document[]
  activities         CrmActivity[]
  projects           Project[]
  treasuryOperations TreasuryOperation[]
  quotes             Quote[]
}

enum ProgrammeType {
  RESIDENTIEL
  COMMERCIAL
  MIXTE
}

enum ProgrammeStatus {
  EN_PROJET
  EN_CONSTRUCTION
  EN_COMMERCIALISATION
  LIVRE
  CLOTURE
}

// ── TERRAINS ───────────────────────────────────────────────────

model Terrain {
  id                           Int           @id @default(autoincrement())
  uuid                         String        @unique @default(cuid())
  reference                    String        @unique // Ex: TER-2024-0001
  lotissementId                Int
  programmeId                  Int? // Programme immobilier d'origine (optionnel)
  ownerId                      Int?
  clientId                     Int? // Attributaire (client à qui le terrain est attribué)
  numeroIlot                   String? // Numéro d'îlot
  numeroParcelle               String? // Numéro de parcelle/lot
  statut                       TerrainStatus @default(DISPONIBLE)
  surface                      Decimal?      @db.Decimal(12, 2) // m²
  prixVente                    Decimal?      @db.Decimal(15, 2)
  // Grille de prix par modalité (surcharge la grille héritée du lotissement).
  salePriceTiers               Json?
  viabilise                    Boolean       @default(false)
  numeroADU                    String? // Numéro ADU
  numeroAttestationAttribution String? // Numéro attestation d'attribution
  numeroAttestationCession     String? // Numéro attestation de cession
  numeroDM                     String? // Numéro décision de morcellement
  titreFoncier                 String? // Numéro titre foncier
  numeroACD                    String? // Numéro arrêté de concession définitive
  description                  String?       @db.Text
  latitude                     Float?
  longitude                    Float?
  // Frais de démarches ACD — option client : prise en charge des démarches ACD
  // par l'entreprise. Indépendant du prix du terrain et des frais de dossier.
  acdDemarchesEnabled          Boolean       @default(false) // Le client a opté pour la prise en charge
  acdDemarchesAmount           Decimal?      @db.Decimal(15, 2) // Montant retenu (pré-rempli depuis Lotissement, modifiable)
  acdDemarchesStartDate        DateTime? // Date de la 1ʳᵉ échéance (ou paiement comptant si cash)
  acdDemarchesInstallmentCount Int? // 1 = comptant, N > 1 = échelonné (cadence mensuelle)
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt
  deletedAt                    DateTime?

  lotissement          Lotissement              @relation(fields: [lotissementId], references: [id])
  programme            ProgrammeImmobilier?     @relation(fields: [programmeId], references: [id])
  owner                Owner?                   @relation(fields: [ownerId], references: [id])
  client               Client?                  @relation(fields: [clientId], references: [id])
  documents            Document[]
  photos               TerrainPhoto[]
  activities           CrmActivity[]
  conventionLinks      ConventionTerrain[]
  priorConventionLinks ConventionPriorTerrain[]
  attestations         Attestation[]
  attestationLinks     AttestationTerrain[]
  invoices             Invoice[]
  installments         SaleInstallment[]
  installmentLinks     SaleInstallmentTerrain[]
  projects             Project[]
  quotes               Quote[]
  quoteLinks           QuoteTerrain[]
  constructionProjects ConstructionProject[]
}

enum TerrainStatus {
  DISPONIBLE
  RESERVE
  VENDU
  SOUS_OPTION
}

model TerrainPhoto {
  id        Int      @id @default(autoincrement())
  terrainId Int
  path      String
  caption   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  terrain Terrain @relation(fields: [terrainId], references: [id])
}

// ── BIENS IMMOBILIERS ─────────────────────────────────────────

model Property {
  id             Int                @id @default(autoincrement())
  uuid           String             @unique @default(cuid())
  reference      String             @unique
  type           PropertyType
  status         PropertyStatus     @default(DISPONIBLE)
  // Origine du bien : un bien provient soit d'un propriétaire, soit d'un
  // programme immobilier (exclusif). Les deux champs peuvent être nuls.
  ownerId        Int?
  programmeId    Int?
  // Client rattaché au bien : présent uniquement lorsque le bien n'est pas
  // DISPONIBLE (réservé, sous option, vendu, en location…). Vidé automatiquement
  // au retour à DISPONIBLE.
  clientId       Int?
  address        String
  addressLine2   String?
  city           String
  postalCode     String
  country        String             @default("CI")
  latitude       Float?
  longitude      Float?
  surface        Decimal?           @db.Decimal(10, 2)
  surfaceCarrez  Decimal?           @db.Decimal(10, 2)
  rooms          Int?
  bedrooms       Int?
  bathrooms      Int?
  floor          Int?
  totalFloors    Int?
  buildYear      Int?
  condition      PropertyCondition?
  garage         String?
  cuisine        String?
  terrasseBalcon String?
  rentPrice      Decimal?           @db.Decimal(15, 2)
  salePrice      Decimal?           @db.Decimal(15, 2)
  // Grille de prix de vente par modalité de paiement (clé = PaymentModalites).
  salePriceTiers Json?
  charges        Decimal?           @db.Decimal(15, 2)
  taxeFonciere   Decimal?           @db.Decimal(15, 2)
  description    String?            @db.Text
  amenities      Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  owner            Owner?                @relation(fields: [ownerId], references: [id])
  programme        ProgrammeImmobilier?  @relation(fields: [programmeId], references: [id])
  client           Client?               @relation("ClientProperties", fields: [clientId], references: [id])
  conventionLinks  ConventionProperty[]
  documents        Document[]
  photos           PropertyPhoto[]
  activities       CrmActivity[]
  attestations     Attestation[]
  attestationLinks AttestationProperty[]
  quotes           Quote[]
  quoteLinks       QuoteProperty[]
}

enum PropertyType {
  APARTEMENT
  DUPLEX
  VILLA
  STUDIO
  BUREAU
  PARKING
  AUTRE
}

enum PropertyStatus {
  DISPONIBLE
  RESERVE
  SOUS_OPTION
  VENDU
  EN_LOCATION
  EN_RENOVATION
  INDISPONIBLE
}

enum PropertyCondition {
  NOUVEAU
  EXCELLENT
  BON
  MOYEN
  MAUVAIS
}

model PropertyPhoto {
  id         Int      @id @default(autoincrement())
  propertyId Int
  path       String
  caption    String?
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
}

// ── CONVENTIONS ───────────────────────────────────────────────

model Convention {
  id                      Int                         @id @default(autoincrement())
  uuid                    String                      @unique @default(cuid())
  reference               String                      @unique
  type                    ConventionType
  status                  ConventionStatus            @default(BROUILLON)
  assetType               ConventionAssetType         @default(PROPERTY)
  clientId                Int
  secondaryClientId       Int?
  parentConventionId      Int?
  amendmentType           ConventionAmendmentType?
  souscriptionType        ConventionSouscriptionType?
  agentId                 Int?
  referrerId              Int?
  startDate               DateTime
  endDate                 DateTime?
  signedAt                DateTime?
  // Date de la convention héritée (importée de la base antérieure) — renseignée
  // pour les types AVENANT_DELAI_HERITE, AVENANT_RESILIATION_HERITE et
  // AVENANT_TRANSFERT_SITE_HERITE.
  priorConventionDate     DateTime?
  // Conditions particulières (texte multi-lignes) choisies dans le formulaire de
  // convention (types hérités) parmi la liste configurée dans les Paramètres.
  conditionsParticulieres String?                     @db.Text
  rentAmount              Decimal?                    @db.Decimal(15, 2)
  saleAmount              Decimal?                    @db.Decimal(15, 2)
  apportInitial           Decimal?                    @db.Decimal(15, 2)
  deposit                 Decimal?                    @db.Decimal(15, 2)
  agencyFees              Decimal?                    @db.Decimal(15, 2)
  charges                 Decimal?                    @db.Decimal(15, 2)
  // Frais d'ouverture de dossier facturés au client à la signature.
  fraisOuvertureDossier   Decimal?                    @db.Decimal(15, 2)
  // Montant supplémentaire éventuel — utilisé pour l'avenant de transfert
  // de site / changement de lot lorsque le nouveau lot induit un complément
  // à payer par le client (différence de prix, frais d'avenant…).
  additionalAmount        Decimal?                    @db.Decimal(15, 2)
  // Total des versements antérieurs et solde antérieur — saisis manuellement
  // pour l'avenant de transfert de site/lot d'une convention HÉRITÉE
  // (AVENANT_TRANSFERT_SITE_HERITE), où la convention initiale n'existe pas
  // dans le système et ne permet pas de calculer ces montants automatiquement.
  priorTotalVersements    Decimal?                    @db.Decimal(15, 2)
  priorSolde              Decimal?                    @db.Decimal(15, 2)
  // Coût total des biens antérieurs — saisi manuellement pour le même avenant
  // de transfert de site/lot d'une convention HÉRITÉE.
  priorTotalBiens         Decimal?                    @db.Decimal(15, 2)
  paymentDay              Int?
  paymentMethod           PaymentMethod               @default(ESPECE)
  paymentModalites        PaymentModalites            @default(CASH)
  installmentCount        Int?
  installmentAmount       Decimal?                    @db.Decimal(15, 2)
  firstInstallmentDate    DateTime?
  lastInstallmentDate     DateTime?
  indexType               String?
  lastRevisionAt          DateTime?
  // Énumération des lots souscrits, figée à l'édition de la convention (même
  // valeur que la variable de template {{convention.lotsSouscrits}}). Stockée
  // pour être affichée sur les factures en face de la référence de convention.
  lotsSouscrits           String?                     @db.Text
  // Énumération des lots ANTÉRIEURS souscrits, figée à l'édition (même valeur que
  // la variable de template {{convention.lotsAnterieursSouscrits}}). Renseignée
  // pour l'avenant de transfert de site / changement de lot (hérité ou non) :
  // énumère les terrains du champ « Terrains antérieurs rattachés ».
  lotsAnterieursSouscrits String?                     @db.Text
  notes                   String?                     @db.Text
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  deletedAt               DateTime?

  properties       ConventionProperty[]
  terrains         ConventionTerrain[]
  priorTerrains    ConventionPriorTerrain[]
  client           Client                   @relation("ConventionClient", fields: [clientId], references: [id])
  secondaryClient  Client?                  @relation("ConventionSecondaryClient", fields: [secondaryClientId], references: [id])
  agent            User?                    @relation("AgentConventions", fields: [agentId], references: [id])
  referrer         BusinessReferrer?        @relation("ConventionReferrer", fields: [referrerId], references: [id])
  // Convention initiale/précédente (pour les avenants et résiliations)
  parentConvention Convention?              @relation("ConventionAmendments", fields: [parentConventionId], references: [id])
  amendments       Convention[]             @relation("ConventionAmendments")
  invoices         Invoice[]
  documents        Document[]
  activities       CrmActivity[]
  installments     SaleInstallment[]
  commissions      Commission[]
  attestations     Attestation[]
  communications   Communication[]
}

// Liaison Convention ↔ Bien immobilier (une convention peut couvrir plusieurs biens).
model ConventionProperty {
  conventionId Int
  propertyId   Int
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  convention Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id])

  @@id([conventionId, propertyId])
  @@index([propertyId])
}

// Liaison Convention ↔ Terrain (une convention peut couvrir plusieurs terrains).
model ConventionTerrain {
  conventionId Int
  terrainId    Int
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  convention Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  terrain    Terrain    @relation(fields: [terrainId], references: [id])

  @@id([conventionId, terrainId])
  @@index([terrainId])
}

// Liaison Convention ↔ Terrain ANTÉRIEUR (avenant de transfert de site /
// changement de lot) : terrains précédemment rattachés, distincts des terrains
// rattachés courants. Même structure que ConventionTerrain.
model ConventionPriorTerrain {
  conventionId Int
  terrainId    Int
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  convention Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  terrain    Terrain    @relation(fields: [terrainId], references: [id])

  @@id([conventionId, terrainId])
  @@index([terrainId])
}

enum ConventionType {
  RENTAL_UNFURNISHED
  RENTAL_FURNISHED
  SALE
  MANAGEMENT
  COMMERCIAL_LEASE
  SOUSCRIPTION
  AVENANT
  RESILIATION
  AVENANT_DELAI_HERITE
  AVENANT_RESILIATION_HERITE
  AVENANT_TRANSFERT_SITE_HERITE
}

enum ConventionAssetType {
  PROPERTY
  TERRAIN
}

enum ConventionAmendmentType {
  PROLONGATION_DELAI
  TRANSFERT_PROPRIETE
  TRANSFERT_SITE
}

// Sous-type d'une convention de souscription (rempli quand type === SOUSCRIPTION).
enum ConventionSouscriptionType {
  STANDARD // Convention de souscription
  AVEC_ACD // Convention de souscription avec ACD
  FINANCEMENT_PROJET // Convention de financement sur projet
}

// Modèle de convention enrichi (texte enrichi HTML : en-tête, corps, pied de page)
model ConventionTemplate {
  id                   Int                         @id @default(autoincrement())
  uuid                 String                      @unique @default(cuid())
  name                 String
  type                 ConventionType
  // Nature spécifique (optionnelle) — laisser vide pour un modèle générique
  // couvrant toutes les natures de ce type de convention.
  amendmentType        ConventionAmendmentType?
  souscriptionType     ConventionSouscriptionType?
  // En-tête monobloc — texte et/ou image. Toute image insérée occupe 100 %
  // de la largeur du bloc (cf. CSS du rendu PDF). La largeur du bloc et sa
  // hauteur sont configurables.
  header               String?                     @db.LongText
  headerWidth          Int                         @default(100)
  headerHeight         Int                         @default(140)
  body                 String                      @db.LongText
  footer               String?                     @db.LongText
  footerWidth          Int                         @default(100)
  footerHeight         Int                         @default(140)
  // Couleur de fond du pied de page (hex `#rrggbb` ou `transparent`).
  // `NULL` ⇒ valeur par défaut historique (`#dc2626`).
  footerBgColor        String?                     @db.VarChar(20)
  // Bloc « Fin du document » — inséré à la suite du corps (signatures,
  // mentions légales finales…). Mêmes contrôles que le pied de page :
  // largeur en %, hauteur en px, couleur de fond optionnelle.
  endOfDocument        String?                     @db.LongText
  endOfDocumentWidth   Int                         @default(100)
  endOfDocumentHeight  Int                         @default(140)
  endOfDocumentBgColor String?                     @db.VarChar(20)
  isActive             Boolean                     @default(true)
  isDefault            Boolean                     @default(false)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  deletedAt            DateTime?
}

enum ConventionStatus {
  BROUILLON
  ACTIVE
  EXPIRE
  TERMINER
  ANNULE
  ATTENTE_SIGNATURE
}

// ── ATTESTATIONS ──────────────────────────────────────────────

// Type d'attestation émise pour un client depuis le module Conventions.
enum AttestationType {
  ATTRIBUTION // Attribution d'un terrain à un client
  CESSION // Cession d'un terrain entre deux clients (cédant ≠ cessionnaire)
  SOLDE // Solde 0 pour acquisition (frais de dossier inclus)
  TRANSFERT_PROPRIETE // Transfert de propriété sur un bien/terrain déjà cédé
}

// Modèle d'attestation enrichi (texte HTML : en-tête, corps, pied de page).
// Un modèle par défaut peut être défini pour chaque type d'attestation.
model AttestationTemplate {
  id                   Int             @id @default(autoincrement())
  uuid                 String          @unique @default(cuid())
  name                 String
  type                 AttestationType
  // En-tête monobloc — texte et/ou image. Toute image insérée occupe 100 %
  // de la largeur du bloc (cf. CSS du rendu PDF). La largeur du bloc et sa
  // hauteur sont configurables.
  header               String?         @db.LongText
  headerWidth          Int             @default(100)
  headerHeight         Int             @default(140)
  body                 String          @db.LongText
  footer               String?         @db.LongText
  footerWidth          Int             @default(100)
  footerHeight         Int             @default(140)
  // Couleur de fond du pied de page (hex `#rrggbb` ou `transparent`).
  // `NULL` ⇒ valeur par défaut historique (`#dc2626`).
  footerBgColor        String?         @db.VarChar(20)
  // Bloc « Fin du document » — inséré à la suite du corps (signatures,
  // mentions légales finales…). Mêmes contrôles que le pied de page.
  endOfDocument        String?         @db.LongText
  endOfDocumentWidth   Int             @default(100)
  endOfDocumentHeight  Int             @default(140)
  endOfDocumentBgColor String?         @db.VarChar(20)
  isActive             Boolean         @default(true)
  isDefault            Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  attestations Attestation[]
}

// Attestation émise pour un client. Référence auto ATT-YYYY-NNNN.
// Rattachement optionnel à une convention, un terrain ou un bien.
// Pour une CESSION, secondaryClientId = cédant (différent du clientId/cessionnaire).
model Attestation {
  id                Int             @id @default(autoincrement())
  uuid              String          @unique @default(cuid())
  reference         String          @unique // Ex: ATT-2026-0007
  type              AttestationType
  clientId          Int // Bénéficiaire (attributaire / cessionnaire / acquéreur)
  secondaryClientId Int? // Cédant (CESSION) ou ancien propriétaire (TRANSFERT_PROPRIETE)
  // Terrain / bien principal — conservé pour compatibilité (souscription
  // héritée, attestations mono-bien historiques) ; toujours renseigné avec le
  // 1ᵉʳ élément de `terrains`/`properties` lorsque la sélection est multiple.
  terrainId         Int?
  propertyId        Int?
  conventionId      Int? // Lien optionnel vers la convention d'origine
  templateId        Int? // Modèle utilisé au moment de l'émission
  emittedAt         DateTime        @default(now())
  emittedById       Int?
  amount            Decimal?        @db.Decimal(15, 2) // Montant (utile pour SOLDE notamment)
  prixTotalBien     Decimal?        @db.Decimal(15, 2) // Prix total du bien (affiché sur l'attestation de solde héritée)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  client          Client                @relation("AttestationClient", fields: [clientId], references: [id])
  secondaryClient Client?               @relation("AttestationSecondaryClient", fields: [secondaryClientId], references: [id])
  terrain         Terrain?              @relation(fields: [terrainId], references: [id])
  property        Property?             @relation(fields: [propertyId], references: [id])
  convention      Convention?           @relation(fields: [conventionId], references: [id])
  template        AttestationTemplate?  @relation(fields: [templateId], references: [id])
  emittedBy       User?                 @relation("AttestationEmittedBy", fields: [emittedById], references: [id])
  documents       Document[]
  terrains        AttestationTerrain[]
  properties      AttestationProperty[]
}

// Liaison Attestation ↔ Terrain (sélection multiple, ex : attribution ou
// cession portant sur plusieurs terrains d'un même lotissement).
model AttestationTerrain {
  attestationId Int
  terrainId     Int
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  attestation Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)
  terrain     Terrain     @relation(fields: [terrainId], references: [id])

  @@id([attestationId, terrainId])
  @@index([terrainId])
}

// Liaison Attestation ↔ Bien immobilier (sélection multiple, ex : attribution
// ou cession portant sur plusieurs biens d'un même programme immobilier).
model AttestationProperty {
  attestationId Int
  propertyId    Int
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  attestation Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id])

  @@id([attestationId, propertyId])
  @@index([propertyId])
}

enum PaymentMethod {
  ESPECE
  CHEQUE
  TRANSFERT
  VIREMENT
  MOBILE_MONEY
  NON_DEFINI
}

enum PaymentModalites {
  CASH
  SUR_3_MOIS
  SUR_6_MOIS
  SUR_9_MOIS
  SUR_12_MOIS
  SUR_24_MOIS
  SUR_36_MOIS
  SUR_48_MOIS
  SUR_60_MOIS
  SUR_PLUS_60_MOIS
}

// ── DEVIS ─────────────────────────────────────────────────────

/// Devis : offre commerciale chiffrée adressée à un prospect ou un client,
/// avant contractualisation. Couvre la vente immobilière (terrain / bien) et
/// les prestations / frais. Référence auto DEV-YYYY-NNNN. Soft delete.
model Quote {
  id                    Int              @id @default(autoincrement())
  uuid                  String           @unique @default(cuid())
  reference             String           @unique // Ex: DEV-2026-0001
  type                  QuoteType        @default(VENTE_TERRAIN)
  status                QuoteStatus      @default(BROUILLON)
  // Objet libre du devis (intitulé affiché en évidence sur le document)
  objet                 String?          @db.VarChar(255)
  // Destinataire — prospect ou client (au moins l'un des deux, invariant applicatif)
  prospectId            Int?
  clientId              Int?
  // Objet optionnel — bien/terrain/programme/lotissement concerné
  terrainId             Int?
  propertyId            Int?
  programmeId           Int?
  lotissementId         Int?
  agentId               Int?
  // Dates de cycle de vie
  issueDate             DateTime         @default(now())
  validUntil            DateTime? // Date limite de validité (expiration auto)
  sentAt                DateTime?
  acceptedAt            DateTime?
  refusedAt             DateTime?
  refusalReason         String?          @db.Text
  // Montants
  subtotal              Decimal          @default(0) @db.Decimal(15, 2)
  discountAmount        Decimal          @default(0) @db.Decimal(15, 2)
  // Remise saisie en pourcentage : si actif, discountAmount = % du sous-total
  // (recalculé côté serveur). Sinon discountAmount est un montant fixe.
  discountIsPercent     Boolean          @default(false)
  discountPercent       Decimal?         @db.Decimal(5, 2)
  taxRate               Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount             Decimal          @default(0) @db.Decimal(15, 2)
  total                 Decimal          @default(0) @db.Decimal(15, 2)
  depositExpected       Decimal?         @db.Decimal(15, 2) // Acompte attendu
  // Acompte saisi en pourcentage : si actif, depositExpected = % du total TTC.
  depositIsPercent      Boolean          @default(false)
  depositPercent        Decimal?         @db.Decimal(5, 2)
  // Modalités de paiement (ventes) — réutilise l'enum des conventions
  paymentModalites      PaymentModalites @default(CASH)
  installmentCount      Int?
  // Contenu
  notes                 String?          @db.Text
  conditions            String?          @db.Text
  templateId            Int?
  // Titre modifiable de la colonne « Référence / LOT » du tableau des articles
  // (null = libellé par défaut « Référence / LOT »)
  referenceColumnLabel  String?
  // Traçabilité de la conversion (scalaires — pas de FK Prisma vers
  // Convention/Invoice pour limiter le couplage ; résolues à la lecture)
  convertedConventionId Int?
  convertedInvoiceId    Int?
  convertedAt           DateTime?
  createdById           Int?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  prospect    Prospect?            @relation(fields: [prospectId], references: [id])
  client      Client?              @relation(fields: [clientId], references: [id])
  terrain     Terrain?             @relation(fields: [terrainId], references: [id])
  property    Property?            @relation(fields: [propertyId], references: [id])
  programme   ProgrammeImmobilier? @relation(fields: [programmeId], references: [id])
  lotissement Lotissement?         @relation(fields: [lotissementId], references: [id])
  agent       User?                @relation("QuoteAgent", fields: [agentId], references: [id])
  createdBy   User?                @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  template    QuoteTemplate?       @relation(fields: [templateId], references: [id])
  items       QuoteItem[]
  activities  CrmActivity[]
  documents   Document[]
  terrains    QuoteTerrain[]
  properties  QuoteProperty[]

  @@index([clientId])
  @@index([prospectId])
  @@index([terrainId])
  @@index([status])
}

// Liaison Devis ↔ Terrain (sélection multiple, ex : devis portant sur
// plusieurs terrains d'un même lotissement). `Quote.terrainId` reste en
// scalaire (aligné sur le 1ᵉʳ élément) pour compatibilité avec les modèles
// de document existants.
model QuoteTerrain {
  quoteId   Int
  terrainId Int
  order     Int      @default(0)
  createdAt DateTime @default(now())

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  terrain Terrain @relation(fields: [terrainId], references: [id])

  @@id([quoteId, terrainId])
  @@index([terrainId])
}

// Liaison Devis ↔ Bien immobilier (sélection multiple, ex : devis portant sur
// plusieurs biens d'un même programme immobilier).
model QuoteProperty {
  quoteId    Int
  propertyId Int
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  quote    Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id])

  @@id([quoteId, propertyId])
  @@index([propertyId])
}

model QuoteItem {
  id            Int               @id @default(autoincrement())
  quoteId       Int
  lineType      QuoteItemLineType @default(ARTICLE)
  designation   String // Pour TITLE/SUBTITLE : porte le texte du titre/sous-titre
  reference     String? // Référence ou lot (optionnelle, par ligne) — libre, ex: article catalogue
  category      String? // Famille/bloc pour le regroupement et le sous-total
  quantity      Decimal           @default(1) @db.Decimal(10, 2)
  unit          String? // Unité de mesure (optionnelle, par ligne) — ex: m², kg, pièce…
  unitPrice     Decimal           @default(0) @db.Decimal(15, 2)
  total         Decimal           @default(0) @db.Decimal(15, 2)
  order         Int               @default(0)
  // Article du catalogue d'origine (scalaire — pas de FK Prisma, pour ne pas
  // bloquer si l'article est supprimé). Sert à empêcher l'ajout en double du
  // même article dans un devis (cf. CatalogPicker.excludeIds).
  catalogItemId Int?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

/// Type de ligne d'un devis : article normal, ligne de titre (affichée en
/// évidence, marque le début d'une section) ou ligne de sous-titre (repère
/// intermédiaire au sein du tableau des articles).
enum QuoteItemLineType {
  ARTICLE
  TITLE
  SUBTITLE
}

/// Modèle de devis paramétrable (header/body/footer HTML + variables), calqué
/// sur AttestationTemplate. Un seul modèle par défaut.
model QuoteTemplate {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(cuid())
  name                 String
  header               String?   @db.LongText
  headerWidth          Int       @default(100)
  headerHeight         Int       @default(140)
  body                 String    @db.LongText
  footer               String?   @db.LongText
  footerWidth          Int       @default(100)
  footerHeight         Int       @default(140)
  footerBgColor        String?   @db.VarChar(20)
  endOfDocument        String?   @db.LongText
  endOfDocumentWidth   Int       @default(100)
  endOfDocumentHeight  Int       @default(140)
  endOfDocumentBgColor String?   @db.VarChar(20)
  isActive             Boolean   @default(true)
  isDefault            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  quotes Quote[]
}

enum QuoteType {
  VENTE_TERRAIN
  VENTE_BIEN
  PRESTATION
  FRAIS
}

enum QuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  EXPIRE
  ANNULE
}

// ── CATALOGUE PRESTATIONS / PRODUITS ──────────────────────────

/// Article prédéfini (prestation ou produit) avec prix unitaire, réutilisable
/// pour pré-remplir les lignes de devis et de factures. Référentiel autonome.
model CatalogItem {
  id          Int             @id @default(autoincrement())
  uuid        String          @unique @default(cuid())
  type        CatalogItemType @default(PRESTATION)
  designation String
  reference   String? // Référence libre de l'article (optionnelle)
  description String?         @db.Text
  category    String? // Famille libre (ex: « Bornage », « Mobilier »…)
  unit        String? // Unité (m², forfait, unité, heure…)
  unitPrice   Decimal         @default(0) @db.Decimal(15, 2)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([type])
}

enum CatalogItemType {
  PRESTATION
  PRODUIT
}

// Référentiel « Catégorie » du catalogue (liste paramétrable). Même principe
// que `KpiUnit` : alimente le sélecteur « Catégorie » du formulaire « Nouvel
// article » (avec création à la volée). La valeur retenue est stockée en clair
// dans `CatalogItem.category`.
model CatalogCategory {
  id        Int       @id @default(autoincrement())
  label     String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ── COMPTABILITÉ ──────────────────────────────────────────────

model Invoice {
  id           Int           @id @default(autoincrement())
  uuid         String        @unique @default(cuid())
  reference    String        @unique
  type         InvoiceType
  status       InvoiceStatus @default(BROUILLON)
  clientId     Int?
  conventionId Int?
  // Rattachement direct à un terrain (utilisé pour les factures de
  // frais de démarches ACD : ces frais sont indépendants d'une convention).
  terrainId    Int?
  subtotal     Decimal       @db.Decimal(15, 2)
  taxRate      Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal       @db.Decimal(15, 2)
  total        Decimal       @db.Decimal(15, 2)
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  paidAt       DateTime?
  notes        String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  client       Client?           @relation(fields: [clientId], references: [id])
  convention   Convention?       @relation(fields: [conventionId], references: [id])
  terrain      Terrain?          @relation(fields: [terrainId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  installments SaleInstallment[]
  activities   CrmActivity[]
  documents    Document[]
  commissions  Commission[]      @relation("InvoiceCommissions")
}

enum InvoiceType {
  VENTE
  ECHEANCE_VENTE
  FRAIS_AGENCE
  FRAIS_DE_GESTION
  FRAIS_DEMARCHES_ACD
  FRAIS_OUVERTURE_DOSSIER
  APPORT_INITIAL
  AVANCE
  CAUTION
  OTHER
}

enum InvoiceStatus {
  BROUILLON
  VALIDEE
  PAYEE
  PARTIEL
  EN_RETARD
  ANNULEE
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id            Int           @id @default(autoincrement())
  invoiceId     Int
  amount        Decimal       @db.Decimal(15, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  reference     String?
  notes         String?
  bankAccountId Int? // Compte de trésorerie crédité par ce règlement

  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
}

// ── ÉCHÉANCES DE VENTE ────────────────────────────────────────

model SaleInstallment {
  id                  Int               @id @default(autoincrement())
  // Rattachement à la convention de vente. Nullable pour supporter les
  // échéances héritées de l'ancienne application (paiements échelonnés sur
  // terrain sans convention signée). Invariant applicatif : au moins l'un de
  // conventionId / clientId est renseigné.
  conventionId        Int?
  // Lien direct au client — utilisé pour les échéances sans convention
  // (données héritées). Pour les échéances issues d'une convention, le client
  // reste accessible via convention.clientId.
  clientId            Int?
  // Terrain concerné par l'échéance héritée (ce qui est payé).
  terrainId           Int?
  // Détails de souscription hérités de l'ancienne application. Affichés sur la
  // facture à la place de la référence de convention (échéances héritées
  // uniquement). Null pour les échéances issues d'une convention.
  detailsSouscription String?           @db.Text
  installmentNumber   Int
  dueDate             DateTime
  amount              Decimal           @db.Decimal(15, 2)
  // Montant déjà encaissé (paiements partiels). status = PARTIEL tant que
  // 0 < paidAmount < amount, PAYE une fois soldé.
  paidAmount          Decimal           @default(0) @db.Decimal(15, 2)
  status              InstallmentStatus @default(EN_ATTENTE)
  paidAt              DateTime?
  paymentMethod       PaymentMethod?
  paymentRef          String?
  invoiceId           Int?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  convention   Convention?              @relation(fields: [conventionId], references: [id])
  client       Client?                  @relation(fields: [clientId], references: [id])
  terrain      Terrain?                 @relation(fields: [terrainId], references: [id])
  invoice      Invoice?                 @relation(fields: [invoiceId], references: [id])
  activities   CrmActivity[]
  commissions  Commission[]
  // Terrains rattachés (échéances héritées) — une échéance peut concerner
  // plusieurs terrains. Sert d'assiette aux frais de démarches ACD.
  terrainLinks SaleInstallmentTerrain[]

  @@index([clientId])
  @@index([terrainId])
}

// Liaison Échéance héritée ↔ Terrain (une échéance héritée sans convention peut
// concerner un ou plusieurs terrains). L'assiette des frais de démarches ACD est
// la somme des frais ACD des terrains rattachés.
model SaleInstallmentTerrain {
  installmentId Int
  terrainId     Int
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  installment SaleInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  terrain     Terrain         @relation(fields: [terrainId], references: [id])

  @@id([installmentId, terrainId])
  @@index([terrainId])
}

enum InstallmentStatus {
  EN_ATTENTE
  A_REGLER
  PARTIEL
  PAYE
  EN_RETARD
  ANNULE
}

// ── MODÈLES DE FACTURE ────────────────────────────────────────
model InvoiceTemplate {
  id                   Int                   @id @default(autoincrement())
  uuid                 String                @unique @default(cuid())
  name                 String
  layout               InvoiceTemplateLayout @default(CLASSIQUE)
  headerHtml           String?               @db.LongText // En-tête éditable (HTML)
  footerHtml           String?               @db.LongText // Pied de page éditable (HTML)
  endOfDocument        String?               @db.LongText // Bloc « Fin du document » (HTML)
  accentColor          String                @default("#1E3A5F")
  // Couleur de fond des bandeaux de titre (récap versement). Le trait latéral
  // gauche des titres garde l'accent.
  sectionColor         String                @default("#d7dfe8")
  // Couleur de fond des en-têtes de tableaux de la facture (distincte des titres).
  tableHeaderColor     String                @default("#e2e8f0")
  // Couleurs de TEXTE des bandeaux de titre et des en-têtes de tableaux.
  sectionTextColor     String                @default("#0f172a")
  tableHeaderTextColor String                @default("#0f172a")
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

enum InvoiceTemplateLayout {
  CLASSIQUE
  MODERNE
  COMPACT
}

// ── MODÈLE D'EXPORT DE LISTES ─────────────────────────────────
// Modèle unique et éditable appliqué aux exports PDF / Excel des listes
// (clients, prospects, biens, etc.). Personnalise l'orientation, la couleur
// d'accent, l'en-tête et le pied de page.
model ListExportTemplate {
  id              Int                   @id @default(autoincrement())
  uuid            String                @unique @default(cuid())
  name            String
  orientation     ListExportOrientation @default(PAYSAGE)
  accentColor     String                @default("#1E3A5F")
  headerHtml      String?               @db.LongText // En-tête éditable (HTML)
  footerHtml      String?               @db.LongText // Pied de page éditable (HTML)
  endOfDocument   String?               @db.LongText // Bloc « Fin du document » (HTML)
  showLogo        Boolean               @default(true) // Afficher le logo (haut à droite)
  showGeneratedAt Boolean               @default(true) // Afficher « Généré le … »
  showRowCount    Boolean               @default(true) // Afficher le nombre de lignes
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

enum ListExportOrientation {
  PORTRAIT
  PAYSAGE
}

// Modèle éditable de l'« Ordre de virement » (Paramètres → Modèles
// d'imprimés) : fiche paysage à transmettre à la banque, listant les salaires
// nets à payer du mois avec les références bancaires de chaque employé.
// Toujours paysage (pas de champ orientation, contrairement à
// ListExportTemplate) — génération réservée à SUPER_ADMIN/ADMIN.
model WireTransferTemplate {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(cuid())
  name           String   @default("Modèle par défaut")
  // Bloc de lignes d'introduction (HTML éditable, texte + formatage par ligne,
  // nombre de lignes libre — 4 lignes par défaut).
  introHtml      String?  @db.LongText
  // Titre du tableau des bénéficiaires (ex. « LISTE DES BÉNÉFICIAIRES »).
  tableTitle     String   @default("LISTE DES BÉNÉFICIAIRES")
  // Libellé sous le bloc de signature (ex. « Le Directeur Général »).
  signatureLabel String   @default("Le Directeur Général")
  // Nom du signataire, affiché sous la fonction (ex. « M. Jean KOUASSI »).
  signatureName  String?
  // Largeurs des 8 colonnes du tableau, en %, dans l'ordre fixe : N°, Nom
  // complet, Code Bancaire, Code Guichet, Numéro de compte, Clé RIB, Banque,
  // Montant. `null` = largeurs par défaut appliquées côté serveur.
  columnWidths   Json?
  accentColor    String   @default("#1E3A5F")
  showLogo       Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── CRM & COMMUNICATION ───────────────────────────────────────

model CrmActivity {
  id                Int            @id @default(autoincrement())
  type              ActivityType
  subject           String
  description       String?        @db.Text
  status            ActivityStatus @default(EN_ATTENTE)
  dueDate           DateTime?
  completedAt       DateTime?
  userId            Int?
  prospectId        Int?
  clientId          Int?
  ownerId           Int?
  propertyId        Int?
  conventionId      Int?
  lotissementId     Int?
  terrainId         Int?
  programmeId       Int?
  invoiceId         Int?
  installmentId     Int?
  projectId         Int?
  quoteId           Int?
  documentId        Int?
  forecastExpenseId Int?
  // Objectif de performance (Mesure « Manuelle ») auquel une tâche est liée.
  // La tâche renseigne une quantité réalisée (`objectiveRealized`) au regard de
  // la cible de l'objectif ; elle ne peut passer « Traité » qu'à 100 %.
  objectiveId       Int?
  objectiveRealized Decimal?       @db.Decimal(15, 2)
  createdById       Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user               User?                         @relation("ActivityAssignedTo", fields: [userId], references: [id])
  createdBy          User?                         @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  forecastExpense    ForecastExpense?              @relation(fields: [forecastExpenseId], references: [id])
  prospect           Prospect?                     @relation(fields: [prospectId], references: [id])
  client             Client?                       @relation(fields: [clientId], references: [id])
  owner              Owner?                        @relation(fields: [ownerId], references: [id])
  property           Property?                     @relation(fields: [propertyId], references: [id])
  convention         Convention?                   @relation(fields: [conventionId], references: [id])
  lotissement        Lotissement?                  @relation(fields: [lotissementId], references: [id])
  terrain            Terrain?                      @relation(fields: [terrainId], references: [id])
  programme          ProgrammeImmobilier?          @relation(fields: [programmeId], references: [id])
  invoice            Invoice?                      @relation(fields: [invoiceId], references: [id])
  installment        SaleInstallment?              @relation(fields: [installmentId], references: [id])
  project            Project?                      @relation(fields: [projectId], references: [id])
  quote              Quote?                        @relation(fields: [quoteId], references: [id])
  document           Document?                     @relation("ActivityLinkedDocument", fields: [documentId], references: [id])
  objective          PerformanceObjective?         @relation(fields: [objectiveId], references: [id])
  // Pièces jointes téléversées pour cette activité (0..n documents GED).
  attachments        Document[]                    @relation("ActivityAttachments")
  // Justification d'une ligne de retard/départ précipité par cette activité
  // (Visite chantier / Sortie en clientèle / Courses, traitée) — au plus une
  // (contrainte unique côté AttendanceDelayJustification.crmActivityId).
  delayJustification AttendanceDelayJustification?

  @@index([objectiveId])
}

enum ActivityType {
  NOTIFICATION
  APPEL
  EMAIL
  SMS
  REUNION
  VISITE
  TASK
  RAPPEL
  DOCUMENT
  CREATION_PUBLICATION
}

enum ActivityStatus {
  EN_ATTENTE
  EN_TRAITEMENT
  TRAITE
  ANNULE
}

model Communication {
  id           Int           @id @default(autoincrement())
  channel      CommChannel
  direction    CommDirection @default(SORTANT)
  to           String
  subject      String?
  body         String        @db.Text
  status       CommStatus    @default(EN_ATTENTE)
  sentAt       DateTime?
  // Remis au serveur de messagerie (destinataire accepté par le SMTP) et
  // première ouverture détectée (pixel de suivi) — emails sortants uniquement.
  deliveredAt  DateTime?
  openedAt     DateTime?
  errorMsg     String?       @db.Text
  templateId   Int?
  // Empreinte d'anti-doublon — verrouille un même rappel (cas + entité + fenêtre)
  // ex. INSTALLMENT_42_J-7. Non posée sur les envois manuels.
  dedupeKey    String?       @unique
  clientId     Int?
  // Rattachements optionnels — utilisés pour l'envoi ciblé depuis l'interface
  // Communication (Propriétaire / Convention / Apporteur d'affaires / Prospect) et la traçabilité.
  ownerId      Int?
  conventionId Int?
  referrerId   Int?
  prospectId   Int?
  // Utilisateur ayant déclenché l'envoi manuel. Null pour les envois
  // systèmes (relances automatiques) — sert au filtrage de visibilité
  // dans l'historique pour les rôles non privilégiés.
  senderId     Int?
  metadata     Json?
  createdAt    DateTime      @default(now())

  template   CommTemplate?     @relation(fields: [templateId], references: [id])
  client     Client?           @relation(fields: [clientId], references: [id])
  owner      Owner?            @relation(fields: [ownerId], references: [id])
  convention Convention?       @relation(fields: [conventionId], references: [id])
  referrer   BusinessReferrer? @relation("CommunicationReferrer", fields: [referrerId], references: [id])
  sender     User?             @relation("CommunicationSentBy", fields: [senderId], references: [id])
  prospect   Prospect?         @relation(fields: [prospectId], references: [id])

  @@index([clientId])
  @@index([ownerId])
  @@index([conventionId])
  @@index([referrerId])
  @@index([senderId])
  @@index([prospectId])
}

model CommTemplate {
  id        Int               @id @default(autoincrement())
  name      String
  channel   CommChannel
  subject   String?
  body      String            @db.Text
  variables Json?
  // Catégorie d'usage : AUTO (relances automatiques) ou MANUEL (envois manuels).
  // Les rôles non privilégiés ne voient que les modèles MANUEL dans l'envoi manuel.
  usageType CommTemplateUsage @default(MANUEL)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  communications Communication[]
  reminderRules  ReminderRule[]
}

enum CommTemplateUsage {
  AUTO
  MANUEL
}

// ── POLITIQUE DE RELANCE ──────────────────────────────────────
//
// Règles déclaratives : une ligne par cas (échéance à venir, en retard, expiration)
// × canal (EMAIL/SMS) × fenêtre (offsetDays). Le scheduler quotidien interprète
// ces règles, applique la déduplication via Communication.dedupeKey et journalise
// une CrmActivity de type RAPPEL.
model ReminderRule {
  id          Int                 @id @default(autoincrement())
  code        String              @unique // ex: INSTALLMENT_UPCOMING_J-7_EMAIL
  name        String
  description String?             @db.Text
  triggerType ReminderTriggerType
  // Décalage par rapport à la date pivot, en jours.
  // Négatif = avant (préventif), positif = après (relance).
  offsetDays  Int
  channel     CommChannel
  templateId  Int?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  template CommTemplate? @relation(fields: [templateId], references: [id])

  @@index([templateId])
}

enum ReminderTriggerType {
  INSTALLMENT_UPCOMING // Échéance de vente à venir (offset négatif)
  INSTALLMENT_OVERDUE // Échéance de vente dépassée (offset positif)
  CONVENTION_EXPIRING // Convention de bail qui arrive à échéance (offset négatif)
}

enum CommChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum CommDirection {
  ENTRANT
  SORTANT
}

enum CommStatus {
  EN_ATTENTE
  ENVOYE
  RECU
  ECHEC
  REFUSE
}

// ── DOCUMENTS ─────────────────────────────────────────────────

model Document {
  id                  Int       @id @default(autoincrement())
  name                String
  type                String // Type MIME
  path                String    @db.VarChar(500) // Chemin de stockage (ou chemin réseau d'archives héritées)
  size                Int // Taille en octets
  category            String? // Catégorie technique héritée (identité, dm_scan…)
  // ── GED (gestion électronique de documents) ──────────────────
  numeroArchive       String?   @unique // Numéro d'archive automatique : ARC-AAAA-NNNN
  description         String?   @db.Text
  categoryId          Int? // Catégorie documentaire (classement)
  folderId            Int? // Dossier dans l'arborescence documentaire
  uploadedById        Int? // Utilisateur ayant importé le document
  ocrText             String?   @db.LongText // Texte extrait par OCR (indexation plein texte)
  isPhysical          Boolean   @default(false) // Possède une contrepartie papier
  physBureau          String? // Localisation physique : bureau
  physCarton          String? // Localisation physique : carton
  physClasseur        String? // Localisation physique : classeur
  // ── Rattachement aux entités métier ──────────────────────────
  clientId            Int?
  ownerId             Int?
  propertyId          Int?
  conventionId        Int?
  lotissementId       Int?
  terrainId           Int?
  programmeId         Int?
  projectId           Int?
  // Rattachements complémentaires : un document peut être lié à au plus
  // une entité de chaque type (FK nullables, pattern identique aux
  // rattachements ci-dessus).
  prospectId          Int?
  referrerId          Int? // Apporteur d'affaires (BusinessReferrer)
  linkedUserId        Int? // Utilisateur rattaché (distinct de uploadedBy)
  invoiceId           Int?
  commissionId        Int?
  attestationId       Int?
  quoteId             Int?
  treasuryOperationId Int? // Opération de trésorerie rattachée
  crmActivityId       Int? // Activité CRM dont ce document est une pièce jointe
  socialPublicationId Int? // Publication/article (réseaux sociaux & web) dont ce document est une pièce jointe
  itInnovationId      Int? // Innovation IT dont ce document est une pièce jointe justificative
  itInnovationPhase   Int? // Phase justifiée par la pièce jointe (1, 2 ou 3)
  uploadedAt          DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  client            Client?              @relation(fields: [clientId], references: [id])
  owner             Owner?               @relation(fields: [ownerId], references: [id])
  property          Property?            @relation(fields: [propertyId], references: [id])
  convention        Convention?          @relation(fields: [conventionId], references: [id])
  lotissement       Lotissement?         @relation(fields: [lotissementId], references: [id])
  terrain           Terrain?             @relation(fields: [terrainId], references: [id])
  programme         ProgrammeImmobilier? @relation(fields: [programmeId], references: [id])
  project           Project?             @relation(fields: [projectId], references: [id])
  prospect          Prospect?            @relation(fields: [prospectId], references: [id])
  referrer          BusinessReferrer?    @relation("DocumentReferrer", fields: [referrerId], references: [id])
  linkedUser        User?                @relation("DocumentLinkedUser", fields: [linkedUserId], references: [id])
  invoice           Invoice?             @relation(fields: [invoiceId], references: [id])
  commission        Commission?          @relation(fields: [commissionId], references: [id])
  attestation       Attestation?         @relation(fields: [attestationId], references: [id])
  quote             Quote?               @relation(fields: [quoteId], references: [id])
  treasuryOperation TreasuryOperation?   @relation(fields: [treasuryOperationId], references: [id])
  documentCategory  DocumentCategory?    @relation(fields: [categoryId], references: [id])
  folder            DocumentFolder?      @relation(fields: [folderId], references: [id])
  uploadedBy        User?                @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  crmActivity       CrmActivity?         @relation("ActivityAttachments", fields: [crmActivityId], references: [id])
  socialPublication SocialPublication?   @relation("SocialPublicationAttachments", fields: [socialPublicationId], references: [id])
  itInnovation      ItInnovation?        @relation("ItInnovationAttachments", fields: [itInnovationId], references: [id])
  tags              DocumentTag[]
  auditLogs         DocumentAuditLog[]
  activities        CrmActivity[]        @relation("ActivityLinkedDocument")
}

// Catégorie documentaire — auto-référencée pour les sous-catégories.
model DocumentCategory {
  id        Int       @id @default(autoincrement())
  name      String
  parentId  Int?
  color     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent    DocumentCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  DocumentCategory[] @relation("CategoryTree")
  documents Document[]
}

// Dossier de l'arborescence documentaire — auto-référencé.
model DocumentFolder {
  id        Int                @id @default(autoincrement())
  name      String
  parentId  Int?
  // Type de dossier :
  //  - GENERAL  : arborescence commune, visible par tous (comportement historique) ;
  //  - PERSONAL : espace personnel d'un utilisateur (ownerId), privé sauf admin/manager ;
  //  - SHARED   : dossier partagé, accessible aux utilisateurs listés (accesses).
  kind      DocumentFolderKind @default(GENERAL)
  // Propriétaire : utilisateur pour un dossier PERSONAL, créateur pour un SHARED.
  ownerId   Int?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  parent    DocumentFolder?        @relation("FolderTree", fields: [parentId], references: [id])
  children  DocumentFolder[]       @relation("FolderTree")
  owner     User?                  @relation("FolderOwner", fields: [ownerId], references: [id])
  accesses  DocumentFolderAccess[]
  documents Document[]
}

enum DocumentFolderKind {
  GENERAL
  PERSONAL
  SHARED
}

// Droit d'accès d'un utilisateur à un dossier partagé (lecture + dépôt).
model DocumentFolderAccess {
  folderId Int
  userId   Int

  folder DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User           @relation("FolderAccessUser", fields: [userId], references: [id])

  @@id([folderId, userId])
}

// Étiquette appliquée à un document (jointure réutilisant le modèle Tag).
model DocumentTag {
  documentId Int
  tagId      Int

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

// Journal des actions sur les documents (traçabilité).
model DocumentAuditLog {
  id         Int                 @id @default(autoincrement())
  documentId Int?
  action     DocumentAuditAction
  userId     Int?
  detail     String?             @db.Text
  createdAt  DateTime            @default(now())

  document Document? @relation(fields: [documentId], references: [id])
  user     User?     @relation("DocumentAuditUser", fields: [userId], references: [id])
}

enum DocumentAuditAction {
  IMPORT
  CONSULTATION
  MODIFICATION
  SUPPRESSION
  TELECHARGEMENT
  RESTAURATION
}

model Note {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  entityType String
  entityId   Int
  userId     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

/// Journal chronologique des changements de statut et modifications de fiche
/// pour les entités Client / Prospect / Apporteur d'affaire (fiche de suivi).
/// Alimenté uniquement à partir de sa mise en place — aucune donnée
/// rétroactive (pas d'historique avant la création de ce modèle). Même
/// convention entityType/entityId que `Note` (pas de relation Prisma typée,
/// pour rester générique).
model EntityTimelineEvent {
  id          Int               @id @default(autoincrement())
  uuid        String            @unique @default(cuid())
  entityType  String // "CLIENT" | "PROSPECT" | "REFERRER"
  entityId    Int
  eventType   TimelineEventType
  description String            @db.Text
  oldValue    String?
  newValue    String?
  userId      Int?
  createdAt   DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

enum TimelineEventType {
  STATUS_CHANGE
  MODIFICATION
}

model Tag {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  color String?

  prospects ProspectTag[]
  documents DocumentTag[]
}

model ProspectTag {
  prospectId Int
  tagId      Int

  prospect Prospect @relation(fields: [prospectId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@id([prospectId, tagId])
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ── PAYS ──────────────────────────────────────────────────────

/// Table de référence des pays : code ISO 3166-1 alpha-2 et indicatif téléphonique.
model Country {
  id       Int    @id @default(autoincrement())
  isoCode  String @unique // Code ISO 3166-1 alpha-2 (ex: CI)
  name     String // Nom du pays en français
  dialCode String // Indicatif téléphonique international (ex: +225)
}

// ── TYPES DE PIÈCES D'IDENTITÉ ────────────────────────────────

/// Catalogue extensible des types de pièces d'identité (CNI, Passeport,
/// Permis de conduire, etc.). Géré depuis Paramètres › Types de pièces
/// d'identité. Une entrée par défaut (CNI) est créée en seed.
model IdDocumentType {
  id        Int       @id @default(autoincrement())
  code      String    @unique // Slug stable (ex: CNI, PASSEPORT)
  label     String // Libellé d'affichage (ex: « Carte Nationale d'Identité (CNI) »)
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clients          Client[] @relation("ClientIdType")
  clientsLegalReps Client[] @relation("ClientLegalRepIdType")
  owners           Owner[]  @relation("OwnerIdType")
  ownersLegalReps  Owner[]  @relation("OwnerLegalRepIdType")
}

// ── NATURES DE TITRES DE LOTISSEMENT ──────────────────────────

/// Catalogue extensible des natures de titres administratifs sollicités pour
/// un lotissement (Arrêté d'approbation, Permis d'aménager, etc.). Géré
/// depuis Paramètres › Natures de titres de lotissement. Une entrée par
/// défaut (Arrêté d'approbation) est créée en seed.
model LotissementTitleType {
  id              Int       @id @default(autoincrement())
  code            String    @unique // Slug stable (ex: ARRETE_APPROBATION)
  label           String // Libellé d'affichage (ex: « Arrêté d'approbation »)
  /// Libellé des documents administratifs livrés avec les terrains de ce
  /// titre (ex: « ACD, plan de masse, situation géographique »). Substitué
  /// dans les modèles de convention / attestation via la variable
  /// `lotissement.documentsLivres`.
  documentsLivres String?   @db.Text
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  lotissements Lotissement[]
}

// ── ARCHIVAGE ─────────────────────────────────────────────────

model ArchiveRecord {
  id            Int               @id @default(autoincrement())
  uuid          String            @unique @default(cuid())
  entityType    ArchiveEntityType
  entityId      Int
  entityRef     String
  snapshot      Json
  reason        ArchiveReason     @default(MANUEL)
  reasonDetail  String?           @db.Text
  archivedById  Int?
  archivedAt    DateTime          @default(now())
  restoredById  Int?
  restoredAt    DateTime?
  status        ArchiveStatus     @default(ARCHIVE)
  retentionDate DateTime?
  notes         String?           @db.Text

  archivedBy User? @relation("ArchivedBy", fields: [archivedById], references: [id])
  restoredBy User? @relation("RestoredBy", fields: [restoredById], references: [id])
}

enum ArchiveEntityType {
  CLIENT
  PROSPECT
  OWNER
  PROPERTY
  CONVENTION
  INVOICE
  DOCUMENT
}

enum ArchiveStatus {
  ARCHIVE
  RESTAURE
  SUPPRIME_DEFINITIVEMENT
}

enum ArchiveReason {
  MANUEL
  CONVENTION_TERMINEE
  CLIENT_INACTIF
  BIEN_VENDU
  POLITIQUE_AUTOMATIQUE
  DEMANDE_RGPD
  AUTRE
}

model ArchivePolicy {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?           @db.Text
  entityType       ArchiveEntityType
  triggerCondition Json
  retentionDays    Int?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ── COMMISSIONS ───────────────────────────────────────────────

// Apporteur d'affaire : référent externe (non-utilisateur de l'application)
model BusinessReferrer {
  id           Int           @id @default(autoincrement())
  uuid         String        @unique @default(cuid())
  firstName    String
  lastName     String
  civilite     CiviliteType?
  companyName  String?
  email        String?
  phone        String?
  mobile       String?
  address      String?
  city         String?
  country      String        @default("CI")
  bankIban     String?
  bankBic      String?
  notes        String?       @db.Text
  isActive     Boolean       @default(true)
  // Utilisateur interne référent de cet apporteur d'affaire (facultatif).
  assignedToId Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  assignedTo     User?           @relation("ReferrerAssignedTo", fields: [assignedToId], references: [id])
  commissions    Commission[]
  clients        Client[]        @relation("ClientReferrer")
  conventions    Convention[]    @relation("ConventionReferrer")
  documents      Document[]      @relation("DocumentReferrer")
  communications Communication[] @relation("CommunicationReferrer")
}

model Commission {
  id              Int                       @id @default(autoincrement())
  uuid            String                    @unique @default(cuid())
  reference       String                    @unique // Ex: COM-2026-0001
  // Rattachement à une convention (cas standard) OU à une échéance héritée
  // (paiement échelonné sans convention). Invariant applicatif : au moins l'un
  // de conventionId / installmentId est renseigné.
  conventionId    Int?
  installmentId   Int?
  // Facture encaissée servant d'assiette (ventes comptant). L'assiette de la
  // commission suit le montant réellement encaissé sur cette facture.
  invoiceId       Int?
  // Bénéficiaire : soit un utilisateur, soit un apporteur d'affaire
  beneficiaryType CommissionBeneficiaryType
  userId          Int?
  referrerId      Int?
  // Calcul de la commission
  transactionType CommissionTransactionType // VENTE ou LOCATION
  baseAmount      Decimal                   @db.Decimal(15, 2) // Assiette (prix de vente ou loyer)
  rate            Decimal                   @db.Decimal(5, 2) // Taux en %
  amount          Decimal                   @db.Decimal(15, 2) // Montant de la commission
  status          CommissionStatus          @default(A_PAYER)
  source          CommissionSource          @default(MANUEL)
  // Paiement
  paidAt          DateTime?
  paymentMethod   PaymentMethod?
  paymentRef      String? // Référence du règlement (chèque, virement…)
  paidById        Int? // Utilisateur ayant enregistré le paiement
  // Annulation
  cancelledAt     DateTime?
  cancelReason    String?                   @db.Text
  cancelledById   Int? // Utilisateur ayant annulé la commission
  notes           String?                   @db.Text
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  deletedAt       DateTime?

  convention  Convention?       @relation(fields: [conventionId], references: [id])
  installment SaleInstallment?  @relation(fields: [installmentId], references: [id])
  invoice     Invoice?          @relation("InvoiceCommissions", fields: [invoiceId], references: [id])
  user        User?             @relation("UserCommissions", fields: [userId], references: [id])
  referrer    BusinessReferrer? @relation(fields: [referrerId], references: [id])
  paidBy      User?             @relation("CommissionPaidBy", fields: [paidById], references: [id])
  cancelledBy User?             @relation("CommissionCancelledBy", fields: [cancelledById], references: [id])
  documents   Document[]

  @@index([installmentId])
  @@index([invoiceId])
}

enum CommissionBeneficiaryType {
  USER // Utilisateur de l'application (agent, manager…)
  REFERRER // Apporteur d'affaire externe
}

enum CommissionTransactionType {
  VENTE
  LOCATION
  SOUSCRIPTION
  FRAIS_DOSSIER
  FRAIS_DEMARCHES_ACD
}

enum CommissionStatus {
  A_PAYER
  PAYEE
  ANNULEE
}

enum CommissionSource {
  MANUEL // Commission saisie manuellement
  AUTOMATIQUE // Commission générée à l'activation de la convention
}

// ── TRÉSORERIE ────────────────────────────────────────────────

// Compte de trésorerie de l'entreprise (banque, caisse espèces ou mobile money).
model BankAccount {
  id             Int                 @id @default(autoincrement())
  uuid           String              @unique @default(cuid())
  name           String // Libellé du compte (ex: « Compte courant SGBCI »)
  type           TreasuryAccountType @default(BANQUE)
  bankName       String? // Nom de la banque / opérateur
  accountNumber  String? // Numéro de compte / RIB
  iban           String?
  bic            String?
  currency       String              @default("XOF")
  initialBalance Decimal             @default(0) @db.Decimal(15, 2) // Solde d'ouverture
  isActive       Boolean             @default(true)
  notes          String?             @db.Text
  // Compte privé : rattaché à un utilisateur. Hors SUPER_ADMIN/ADMIN, seul cet
  // utilisateur peut consulter le compte et y enregistrer des opérations.
  linkedUserId   Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  linkedUser         User?               @relation("BankAccountLinkedUser", fields: [linkedUserId], references: [id])
  operations         TreasuryOperation[]
  payments           Payment[]
  usersDefaultEntree User[]              @relation("UserDefaultEntreeAccount")
  usersDefaultSortie User[]              @relation("UserDefaultSortieAccount")
  // Utilisateurs (non-admin) pour lesquels ce compte s'affiche dans le bloc
  // « Comptes de trésorerie » du tableau de bord. Liste d'affichage uniquement,
  // distincte du compte privé (`linkedUserId`) qui régit l'accès en écriture.
  viewers            BankAccountViewer[]
}

// Liste d'affichage d'un compte de trésorerie : association compte ↔ utilisateur
// déterminant quels utilisateurs voient le compte dans le bloc « Comptes de
// trésorerie ». Les SUPER_ADMIN / ADMIN voient tous les comptes quoi qu'il arrive.
model BankAccountViewer {
  bankAccountId Int
  userId        Int

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([bankAccountId, userId])
}

enum TreasuryAccountType {
  BANQUE
  CAISSE
  CAISSE_CENTRALE
  MOBILE_MONEY
}

// Objet d'opération : nature paramétrable d'une entrée/sortie, rattachée à un
// numéro de compte comptable (ex: 301).
model TreasuryCategory {
  id             Int               @id @default(autoincrement())
  uuid           String            @unique @default(cuid())
  label          String // Libellé de l'objet (ex: « Encaissement loyer »)
  direction      TreasuryDirection // Sens de l'opération : ENTREE ou SORTIE
  accountingCode String? // Numéro de compte comptable (ex: « 301 »)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  operations       TreasuryOperation[]
  forecastExpenses ForecastExpense[]
}

enum TreasuryDirection {
  ENTREE
  SORTIE
}

// Mouvement de trésorerie : entrée ou sortie d'argent sur un compte.
model TreasuryOperation {
  id                Int               @id @default(autoincrement())
  uuid              String            @unique @default(cuid())
  reference         String            @unique // Ex: OPT-2026-0001
  bankAccountId     Int
  direction         TreasuryDirection
  amount            Decimal           @db.Decimal(15, 2)
  operationDate     DateTime          @default(now())
  categoryId        Int? // Objet d'opération
  label             String // Libellé de l'opération
  paymentMethod     PaymentMethod     @default(ESPECE)
  paymentRef        String? // Référence du règlement (chèque, virement…)
  source            TreasurySource    @default(MANUEL)
  paymentId         Int? // Paiement de facture rattaché (source FACTURE)
  installmentId     Int? // Échéance de vente rattachée (source ECHEANCE)
  commissionId      Int? // Commission rattachée (source COMMISSION)
  payslipId         Int? // Bulletin de salaire rattaché (source PAIE)
  forecastExpenseId Int? // Charge prévisionnelle réglée (source CHARGE)
  budgetLineId      Int? // Ligne budgétaire d'imputation (sorties uniquement)
  // Tiers de l'opération : bénéficiaire (« à destination de » pour une sortie)
  // ou émetteur (« en provenance de » pour une entrée). Facultatif.
  thirdPartyId      Int?
  // Imputation analytique : une opération peut être rattachée à au plus UNE
  // entité parmi projet / lotissement / programme immobilier. L'exclusivité est
  // appliquée en code (validation Zod côté IPC).
  projectId         Int? // Projet rattaché
  lotissementId     Int? // Lotissement rattaché
  programmeId       Int? // Programme immobilier rattaché
  // Virement interne compte à compte : regroupe les deux écritures (crédit sur
  // un compte, débit sur l'autre) générées ensemble pour un même mouvement.
  // Même valeur sur les deux lignes ; null pour une opération simple.
  transferGroupId   String?
  createdById       Int?
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  bankAccount     BankAccount          @relation(fields: [bankAccountId], references: [id])
  category        TreasuryCategory?    @relation(fields: [categoryId], references: [id])
  createdBy       User?                @relation("TreasuryCreatedBy", fields: [createdById], references: [id])
  budgetLine      BudgetLine?          @relation(fields: [budgetLineId], references: [id])
  project         Project?             @relation(fields: [projectId], references: [id])
  lotissement     Lotissement?         @relation(fields: [lotissementId], references: [id])
  programme       ProgrammeImmobilier? @relation(fields: [programmeId], references: [id])
  thirdParty      TreasuryThirdParty?  @relation(fields: [thirdPartyId], references: [id])
  payslip         Payslip?             @relation(fields: [payslipId], references: [id])
  forecastExpense ForecastExpense?     @relation(fields: [forecastExpenseId], references: [id])
  documents       Document[]

  @@index([transferGroupId])
}

// Tiers de trésorerie : bénéficiaire (« à destination de ») d'une sortie ou
// émetteur (« en provenance de ») d'une entrée. Liste paramétrable, réutilisée
// pour les deux sens d'opération.
model TreasuryThirdParty {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(cuid())
  fullName  String // Nom complet du tiers
  contacts  String? // Contacts (téléphone, email…)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  operations TreasuryOperation[]
}

enum TreasurySource {
  MANUEL // Opération saisie manuellement
  FACTURE // Générée par l'encaissement d'une facture
  ECHEANCE // Générée par le règlement d'une échéance de vente
  COMMISSION // Générée par le paiement d'une commission
  PAIE // Générée par le paiement d'un bulletin de salaire
  CHARGE // Générée par le règlement d'une charge prévisionnelle
  TRANSFERT // Virement interne compte à compte (écriture liée par transferGroupId)
}

// Charge / dépense prévisionnelle : montant à régler à une date prévue, dont
// l'objet provient des objets de sortie de la trésorerie. Son règlement génère
// une opération de trésorerie (sortie) et clôt le rappel CRM associé.
model ForecastExpense {
  id            Int                   @id @default(autoincrement())
  uuid          String                @unique @default(cuid())
  reference     String                @unique // Ex: CHP-2026-0001
  label         String // Libellé de la charge
  categoryId    Int // Objet de sortie (TreasuryCategory direction SORTIE)
  amount        Decimal               @db.Decimal(15, 2) // Montant prévisionnel
  dueDate       DateTime // Date prévue de règlement
  status        ForecastExpenseStatus @default(PREVUE)
  notes         String?               @db.Text
  // Règlement effectif
  settledAt     DateTime?
  settledAmount Decimal?              @db.Decimal(15, 2)
  paymentMethod PaymentMethod?
  // Traçabilité
  createdById   Int? // Planificateur (visibilité par rôle)
  settledById   Int?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?

  category   TreasuryCategory    @relation(fields: [categoryId], references: [id])
  createdBy  User?               @relation("ForecastExpenseCreatedBy", fields: [createdById], references: [id])
  settledBy  User?               @relation("ForecastExpenseSettledBy", fields: [settledById], references: [id])
  operations TreasuryOperation[]
  activities CrmActivity[]

  @@index([categoryId])
  @@index([createdById])
}

enum ForecastExpenseStatus {
  PREVUE // Planifiée, non réglée
  REGLEE // Réglée (opération de trésorerie générée)
  ANNULEE // Annulée
}

// ── BUDGETS ───────────────────────────────────────────────────

// Budget : enveloppe globale (période, total alloué, statut). Regroupe des
// lignes budgétaires. Lorsqu'il est clôturé, plus aucune opération ne peut être
// imputée à ses lignes et un récapitulatif figé est conservé dans `closingSnapshot`.
model Budget {
  id              Int          @id @default(autoincrement())
  uuid            String       @unique @default(cuid())
  reference       String       @unique // Ex: BUDG-2026-0001
  name            String
  description     String?      @db.Text
  periodStart     DateTime
  periodEnd       DateTime
  totalAllocated  Decimal?     @db.Decimal(15, 2) // Optionnel : somme indicative
  status          BudgetStatus @default(OUVERT)
  closingSnapshot Json? // Récapitulatif figé à la clôture
  closedAt        DateTime?
  closedById      Int?
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  closedBy User?        @relation("BudgetClosedBy", fields: [closedById], references: [id])
  lines    BudgetLine[]
}

enum BudgetStatus {
  OUVERT
  CLOTURE
}

// Ligne budgétaire : poste de dépense rattaché à un budget. Gérée par un
// utilisateur (`managerId`, qui ne peut pas être un ADMIN ou un SUPER_ADMIN) ;
// seul ce gestionnaire — ou un ADMIN/SUPER_ADMIN — peut y imputer une opération
// de sortie de trésorerie.
model BudgetLine {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(cuid())
  budgetId        Int
  code            String? // Code court optionnel (ex: BL-001)
  label           String
  description     String?   @db.Text
  allocatedAmount Decimal   @db.Decimal(15, 2)
  managerId       Int?
  isActive        Boolean   @default(true)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  budget     Budget              @relation(fields: [budgetId], references: [id])
  manager    User?               @relation("BudgetLineManager", fields: [managerId], references: [id])
  operations TreasuryOperation[]
}

// ── PROJETS ───────────────────────────────────────────────────

// Catalogue extensible des types de projets (Construction de bâtiments,
// Bornage, Bitumage, etc.). Géré depuis Paramètres › Types de projets.
model ProjectType {
  id          Int       @id @default(autoincrement())
  code        String    @unique // Slug stable (ex: CONSTRUCTION_BATIMENTS)
  label       String // Libellé d'affichage
  description String?   @db.Text
  color       String? // Couleur hex (ex: #2563EB)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  projects Project[]
}

// Projet : opération supervisée par l'agence (construction, ouverture de
// voies, bornage, bitumage…). Référence auto PROJ-YYYY-NNNN. Rattachements
// optionnels : client commanditaire, propriétaire, terrain, lotissement,
// programme immobilier.
model Project {
  id             Int           @id @default(autoincrement())
  uuid           String        @unique @default(cuid())
  reference      String        @unique // Ex: PROJ-2026-0001
  nom            String
  typeId         Int // Type de projet (obligatoire)
  statut         ProjectStatus @default(EN_PROJET)
  // Rattachements optionnels
  clientId       Int?
  ownerId        Int?
  terrainId      Int?
  lotissementId  Int?
  programmeId    Int?
  // Localisation
  adresse        String?
  commune        String?
  quartier       String?
  ville          String?
  pays           String        @default("CI")
  latitude       Float?
  longitude      Float?
  // Dates & avancement
  dateDebutPrevu DateTime?
  dateDebutReel  DateTime?
  dateFinPrevue  DateTime?
  dateFinReelle  DateTime?
  avancement     Int           @default(0) // Taux d'avancement 0–100 %
  // Financier
  budgetPrevu    Decimal?      @db.Decimal(15, 2)
  budgetRealise  Decimal?      @db.Decimal(15, 2)
  // Description
  description    String?       @db.Text
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  type                 ProjectType           @relation(fields: [typeId], references: [id])
  client               Client?               @relation(fields: [clientId], references: [id])
  owner                Owner?                @relation(fields: [ownerId], references: [id])
  terrain              Terrain?              @relation(fields: [terrainId], references: [id])
  lotissement          Lotissement?          @relation(fields: [lotissementId], references: [id])
  programme            ProgrammeImmobilier?  @relation(fields: [programmeId], references: [id])
  photos               ProjectPhoto[]
  documents            Document[]
  activities           CrmActivity[]
  treasuryOperations   TreasuryOperation[]
  constructionProjects ConstructionProject[]
}

enum ProjectStatus {
  EN_PROJET
  EN_COURS
  SUSPENDU
  TERMINE
  ANNULE
}

model ProjectPhoto {
  id        Int      @id @default(autoincrement())
  projectId Int
  path      String
  caption   String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

// ── RESSOURCES HUMAINES — PERSONNEL ───────────────────────────
// Module RH/Paie (gestion conforme Côte d'Ivoire). Phase 1 : dossiers du
// personnel et contrats de travail. Les bulletins de paie, congés et pointage
// sont ajoutés dans les phases suivantes.
model Employee {
  id                Int                 @id @default(autoincrement())
  uuid              String              @unique @default(cuid())
  matricule         String              @unique // Ex: EMP-2026-0001
  // État civil
  civilite          CiviliteType?
  firstName         String
  lastName          String
  sexe              EmployeeSexe?
  birthDate         DateTime?
  birthPlace        String?
  nationality       String?             @default("CI")
  maritalStatus     StatutConjugalType?
  childrenCount     Int                 @default(0)
  igrParts          Decimal             @default(1) @db.Decimal(4, 1) // nombre de parts IGR (quotient familial)
  // Coordonnées
  email             String?
  phone             String?
  mobile            String?
  address           String?
  city              String?
  // Identité & protection sociale
  idNumber          String? // numéro pièce d'identité
  cnpsNumber        String? // numéro CNPS (sécurité sociale)
  cmuNumber         String? // numéro CMU (couverture maladie universelle)
  // Coordonnées bancaires (versement du salaire)
  bankName          String?
  bankRib           String?
  bankCode          String? // Code Banque
  bankGuichetCode   String? // Code Guichet
  bankAccountNumber String? // Numéro de compte
  bankRibKey        String? // Clé RIB
  // Poste
  poste             String?
  departement       String?
  // Filière de carrière (profil unique auquel l'employé est explicitement rattaché —
  // un employé n'appartient qu'à une seule filière à la fois, contrairement à un
  // poste qui peut figurer dans plusieurs profils de carrière).
  careerProfileId   Int?
  // Responsable hiérarchique (évaluateur au titre de la gestion de la performance)
  managerId         Int?
  // Lien optionnel vers un compte utilisateur de l'application
  userId            Int?                @unique
  // Statut emploi
  status            EmployeeStatus      @default(ACTIF)
  hireDate          DateTime?
  exitDate          DateTime?
  exitReason        String?
  photo             String?
  notes             String?             @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  user                User?                          @relation("UserEmployee", fields: [userId], references: [id])
  careerProfile       CareerProfile?                 @relation(fields: [careerProfileId], references: [id])
  manager             Employee?                      @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates        Employee[]                     @relation("EmployeeManager")
  contracts           EmploymentContract[]           @relation("EmployeeContracts")
  authorityContracts  EmploymentContract[]           @relation("ContractAuthority")
  payslips            Payslip[]
  leaveRequests       LeaveRequest[]
  attendance          AttendanceRecord[]
  signedContracts     EmployeeSignedContract[]
  perfObjectives      PerformanceObjective[]
  perfEvaluations     PerformanceEvaluation[]
  progressPlans       ProgressPlan[]
  perfRankingEntries  PerformanceRankingEntry[]
  delayJustifications AttendanceDelayJustification[]
  innovations         ItInnovation[]

  @@index([managerId])
  @@index([careerProfileId])
}

// Contrats signés (fichiers téléversés) rattachés à un employé — consultables
// par le personnel dans « Mon espace RH → Profil & Contrats » (lecture seule).
model EmployeeSignedContract {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  name         String
  type         String // MIME
  path         String // chemin relatif dans le storage
  size         Int
  uploadedById Int?
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

enum EmployeeSexe {
  MASCULIN
  FEMININ
}

enum EmployeeStatus {
  ACTIF
  SUSPENDU
  CONGE
  SORTI
}

model EmploymentContract {
  id                     Int            @id @default(autoincrement())
  uuid                   String         @unique @default(cuid())
  reference              String         @unique // Ex: CTR-2026-0001
  employeeId             Int
  type                   ContractType   @default(CDI)
  status                 ContractStatus @default(ACTIF)
  poste                  String?
  categorie              String? // catégorie / classification professionnelle
  startDate              DateTime
  endDate                DateTime? // requis pour CDD / STAGE
  trialEndDate           DateTime? // fin de période d'essai
  weeklyHours            Decimal?       @db.Decimal(5, 2) // durée hebdomadaire
  baseSalary             Decimal        @db.Decimal(15, 2) // salaire de base mensuel brut
  // Détail de rémunération inscrit au contrat (CDI/CDD). Saisi manuellement —
  // valeurs négociées figurant dans la clause de rémunération.
  sursalaire             Decimal?       @db.Decimal(15, 2)
  primeAnciennete        Decimal?       @db.Decimal(15, 2)
  grossSalary            Decimal?       @db.Decimal(15, 2) // salaire brut (base + sursalaire + prime d'ancienneté)
  its                    Decimal?       @db.Decimal(15, 2) // retenue ITS
  cnps                   Decimal?       @db.Decimal(15, 2) // retenue CNPS (part salariale)
  cmu                    Decimal?       @db.Decimal(15, 2) // retenue CMU (part salariale)
  totalDeductions        Decimal?       @db.Decimal(15, 2) // total des retenues (ITS + CNPS + CMU)
  transportAllowance     Decimal?       @db.Decimal(15, 2) // prime de transport
  netSalary              Decimal?       @db.Decimal(15, 2) // salaire net à payer
  // Avenant CDD : rattachement au contrat CDD initial amendé (cumul ≤ 2 ans).
  // Renseigné uniquement pour les contrats de type AVENANT_CDD.
  parentContractId       Int?
  // Autorité responsable : employé signataire/responsable au titre du contrat
  // (distinct du salarié titulaire). Optionnel.
  responsibleAuthorityId Int?
  // Fonction de l'employé (référentiel paramétrable : titre + contenu en liste).
  functionId             Int?
  // Objectifs assignés (référentiel paramétrable : titre + contenu en liste).
  objectiveId            Int?
  // Commissions sur activité auxquelles l'employé a droit pour ce contrat.
  // Instantané JSON : tableau de { key, label, rate } (rate = taux en %).
  activityCommissions    Json?
  notes                  String?        @db.Text
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?

  employee             Employee             @relation("EmployeeContracts", fields: [employeeId], references: [id])
  responsibleAuthority Employee?            @relation("ContractAuthority", fields: [responsibleAuthorityId], references: [id])
  parentContract       EmploymentContract?  @relation("ContractAmendments", fields: [parentContractId], references: [id])
  amendments           EmploymentContract[] @relation("ContractAmendments")
  fonction             ContractFunction?    @relation(fields: [functionId], references: [id])
  objective            ContractObjective?   @relation(fields: [objectiveId], references: [id])
  payslips             Payslip[]

  @@index([employeeId])
  @@index([parentContractId])
  @@index([responsibleAuthorityId])
  @@index([functionId])
  @@index([objectiveId])
}

// Modèle éditable de « fiche de poste » rattachée à un contrat. Mêmes zones
// que ContractTemplate (en-tête / corps / fin du document / pied de page) ;
// utilise les mêmes variables de contrat. Plusieurs modèles, un par défaut.
model JobDescriptionTemplate {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(cuid())
  name                 String
  header               String?   @db.LongText
  headerWidth          Int       @default(100)
  headerHeight         Int       @default(140)
  body                 String    @db.LongText
  footer               String?   @db.LongText
  footerWidth          Int       @default(100)
  footerHeight         Int       @default(140)
  footerBgColor        String?   @db.VarChar(20)
  endOfDocument        String?   @db.LongText
  endOfDocumentWidth   Int       @default(100)
  endOfDocumentHeight  Int       @default(140)
  endOfDocumentBgColor String?   @db.VarChar(20)
  isDefault            Boolean   @default(false)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
}

// Fonction de l'employé (référentiel paramétrable) : un titre et un contenu
// (une ligne = un élément, affiché en liste à puces dans le contrat).
model ContractFunction {
  id        Int       @id @default(autoincrement())
  titre     String
  contenu   String    @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contracts EmploymentContract[]
}

// Référentiel « Objectifs assignés » (titre + contenu en liste). Même principe
// que ContractFunction : sélectionnable sur un contrat, alimente les variables
// {{contrat.objectifs.titre}} / {{contrat.objectifs.contenu}}.
model ContractObjective {
  id        Int       @id @default(autoincrement())
  titre     String
  contenu   String    @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contracts EmploymentContract[]
}

// Référentiel « Poste / Fonction » du personnel (liste paramétrable). Alimente
// le sélecteur « Poste » de la fiche employé (avec création à la volée). La
// valeur retenue est stockée en clair dans `Employee.poste` (libellé), afin de
// rester compatible avec les valeurs libres existantes et les clés « poste »
// des profils de pondération et des objectifs par poste.
model JobPosition {
  id        Int       @id @default(autoincrement())
  label     String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Profil de carrière : filière métier regroupant plusieurs postes (référentiel
// JobPosition, par libellé) selon un ordre de progression. Paramétrable
// uniquement par SUPER_ADMIN/ADMIN (career-profiles.ipc.ts), affiché en
// lecture seule à l'employé dans « Mon espace RH » (poste actuel mis en
// évidence — hr:me:careerProfile).
model CareerProfile {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(cuid())
  name        String
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  steps     CareerProfileStep[]
  employees Employee[]
}

// Étape (niveau) d'un profil de carrière : un poste donné (libellé, comme
// Employee.poste / JobPosition.label) occupe un rang dans la filière. Un même
// poste peut appartenir à plusieurs profils de carrière (ex. filières
// transverses), mais ne peut apparaître qu'une seule fois au sein d'un même
// profil (@@unique([careerProfileId, poste])).
model CareerProfileStep {
  id                  Int      @id @default(autoincrement())
  careerProfileId     Int
  poste               String
  order               Int
  // Rôle principal (mission essentielle) occupé à ce niveau de la filière.
  rolePrincipal       String?  @db.Text
  // Compétences et diplômes requis pour occuper ce poste/niveau.
  competencesDiplomes String?  @db.Text
  // Catégorie socio-professionnelle (référentiel EssaiCategory.label).
  categorieSocioPro   String?
  // Code exact de la catégorie (ex. « 1A », « 2B » — classification de la convention collective).
  categorieCode       String?
  // Avantages liés à ce poste/niveau (primes, véhicule, logement…).
  avantages           String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  careerProfile CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)

  @@unique([careerProfileId, order])
  @@unique([careerProfileId, poste])
  @@index([careerProfileId])
}

// Référentiel « Département / Service » du personnel (liste paramétrable). Même
// principe que JobPosition : alimente le sélecteur « Département / service » de
// la fiche employé (avec création à la volée). La valeur retenue est stockée en
// clair dans `Employee.departement` (libellé).
model Department {
  id        Int       @id @default(autoincrement())
  label     String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum ContractType {
  CDI
  CDD
  STAGE
  INTERIM
  CONSULTANT
  APPRENTISSAGE
  ESSAI
  AVENANT_CDD // Avenant de prolongation rattaché à un CDD (cumul ≤ 2 ans)
  RENOUVELLEMENT_ESSAI // Lettre de renouvellement rattachée à un ESSAI (durée = essai initial)
}

// Catégorie socio-professionnelle et délai d'essai associé (paramétrable).
// Sert de référence pour les contrats ESSAI (auto-remplissage de la durée).
model EssaiCategory {
  id            Int               @id @default(autoincrement())
  label         String            @unique
  durationValue Int // valeur du délai d'essai
  durationUnit  EssaiDurationUnit @default(MOIS)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
}

enum EssaiDurationUnit {
  JOURS
  MOIS
}

enum ContractStatus {
  BROUILLON
  ACTIF
  SUSPENDU
  TERMINE
  ROMPU
}

// ── RESSOURCES HUMAINES — PAIE (bulletins) ────────────────────
// Calcul conforme Côte d'Ivoire (CNPS, ITS, CMU, charges patronales). Les taux
// et barèmes sont paramétrables via AppSetting (clés payroll.*).
model Payslip {
  id              Int            @id @default(autoincrement())
  uuid            String         @unique @default(cuid())
  reference       String         @unique // BUL-YYYY-NNNN
  employeeId      Int
  contractId      Int?
  periodYear      Int
  periodMonth     Int // 1-12
  // Nombre de parts IGR figé à la génération (celui de l'employé à cet
  // instant) — l'ITS de ce bulletin en dépend ; un changement ultérieur du
  // nombre de parts de l'employé ne doit jamais modifier un bulletin déjà émis.
  igrParts        Decimal        @default(1) @db.Decimal(4, 1)
  // Montants (FCFA)
  baseSalary      Decimal        @db.Decimal(15, 2) // salaire de base
  grossTaxable    Decimal        @db.Decimal(15, 2) // brut imposable
  totalGains      Decimal        @db.Decimal(15, 2) // total des gains (brut + indemnités)
  cnpsEmployee    Decimal        @db.Decimal(15, 2) // retenue CNPS salarié
  its             Decimal        @db.Decimal(15, 2) // impôt sur traitements et salaires
  cmuEmployee     Decimal        @db.Decimal(15, 2) // CMU part salarié
  otherDeductions Decimal        @default(0) @db.Decimal(15, 2)
  totalDeductions Decimal        @db.Decimal(15, 2)
  netSalary       Decimal        @db.Decimal(15, 2) // net à payer
  employerCharges Decimal        @db.Decimal(15, 2) // total charges patronales
  employerCost    Decimal        @db.Decimal(15, 2) // coût total employeur
  status          PayslipStatus  @default(BROUILLON)
  paidAt          DateTime?
  paymentMethod   PaymentMethod?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  employee   Employee            @relation(fields: [employeeId], references: [id])
  contract   EmploymentContract? @relation(fields: [contractId], references: [id])
  lines      PayslipLine[]
  operations TreasuryOperation[]

  @@unique([employeeId, periodYear, periodMonth])
  @@index([employeeId])
}

enum PayslipStatus {
  BROUILLON
  VALIDE
  PAYE
  ANNULE
}

model PayslipLine {
  id        Int             @id @default(autoincrement())
  payslipId Int
  type      PayslipLineType
  label     String
  base      Decimal?        @db.Decimal(15, 2)
  rate      Decimal?        @db.Decimal(7, 4)
  amount    Decimal         @db.Decimal(15, 2)
  order     Int             @default(0)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId])
}

enum PayslipLineType {
  GAIN
  RETENUE
  CHARGE_PATRONALE
  INFO
}

// Modèles éditables de contrats de travail (corps en HTML avec variables {{…}}).
// Un modèle par défaut par type de contrat ; repli sur le modèle intégré si aucun.
// Zones En-tête / Corps / Fin du document / Pied de page calquées sur
// ConventionTemplate (rendu PDF avec en-tête/pied répétés sur chaque page).
model ContractTemplate {
  id                   Int          @id @default(autoincrement())
  uuid                 String       @unique @default(cuid())
  name                 String
  type                 ContractType
  // En-tête monobloc — texte et/ou image (image insérée → 100 % de la largeur
  // du bloc, cf. CSS du rendu PDF). Largeur et hauteur configurables.
  header               String?      @db.LongText
  headerWidth          Int          @default(100)
  headerHeight         Int          @default(140)
  body                 String       @db.LongText
  footer               String?      @db.LongText
  footerWidth          Int          @default(100)
  footerHeight         Int          @default(140)
  // Couleur de fond du pied de page (`#rrggbb` ou `transparent`). `NULL` ⇒
  // valeur par défaut historique (`#dc2626`).
  footerBgColor        String?      @db.VarChar(20)
  // Bloc « Fin du document » — inséré à la suite du corps (signatures, mentions
  // finales…), une seule fois. Mêmes contrôles que le pied de page.
  endOfDocument        String?      @db.LongText
  endOfDocumentWidth   Int          @default(100)
  endOfDocumentHeight  Int          @default(140)
  endOfDocumentBgColor String?      @db.VarChar(20)
  isDefault            Boolean      @default(false)
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?
}

// Modèles éditables de bulletins de paie : 3 mises en page (MODELE_1/2/3),
// en-tête / pied de page / couleur d'accent personnalisables.
model PayslipTemplate {
  id          Int                   @id @default(autoincrement())
  uuid        String                @unique @default(cuid())
  name        String
  layout      PayslipTemplateLayout @default(MODELE_1)
  headerHtml  String?               @db.LongText
  footerHtml  String?               @db.LongText
  accentColor String                @default("#1E3A5F")
  isDefault   Boolean               @default(false)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

enum PayslipTemplateLayout {
  MODELE_1
  MODELE_2
  MODELE_3
}

// ── RESSOURCES HUMAINES — CONGÉS & ABSENCES ───────────────────
model LeaveType {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  isPaid         Boolean  @default(true)
  affectsBalance Boolean  @default(false) // déduit du solde de congés payés
  color          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requests LeaveRequest[]
}

model LeaveRequest {
  id            Int         @id @default(autoincrement())
  uuid          String      @unique @default(cuid())
  reference     String      @unique // CGE-YYYY-NNNN
  employeeId    Int
  typeId        Int
  startDate     DateTime
  endDate       DateTime
  days          Decimal     @db.Decimal(5, 1) // jours décomptés
  reason        String?     @db.Text
  status        LeaveStatus @default(EN_ATTENTE)
  decidedById   Int?
  decidedAt     DateTime?
  decisionNote  String?
  // Fiche « Congés & Absence » signée, scannée et jointe après validation.
  signedDocPath String?
  signedDocName String?
  signedDocType String?
  signedDocSize Int?
  signedDocAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  employee            Employee                       @relation(fields: [employeeId], references: [id])
  type                LeaveType                      @relation(fields: [typeId], references: [id])
  decidedBy           User?                          @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  delayJustifications AttendanceDelayJustification[]

  @@index([employeeId])
  @@index([typeId])
}

enum LeaveStatus {
  EN_ATTENTE
  APPROUVE
  REFUSE
  ANNULE
}

// ── RESSOURCES HUMAINES — POINTAGE / HEURES ───────────────────
model AttendanceRecord {
  id            Int              @id @default(autoincrement())
  uuid          String           @unique @default(cuid())
  employeeId    Int
  date          DateTime         @db.Date
  status        AttendanceStatus @default(PRESENT)
  hoursWorked   Decimal          @default(0) @db.Decimal(5, 2)
  overtimeHours Decimal          @default(0) @db.Decimal(5, 2)
  arrivalTime   DateTime? // Heure de pointage d'arrivée (scan QR)
  departureTime DateTime? // Heure de pointage de départ (scan QR)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  CONGE
  REPOS
  FERIE
  MALADIE
}

// ── GESTION DES VISITEURS ─────────────────────────────────────
model Visitor {
  id          Int           @id @default(autoincrement())
  uuid        String        @unique @default(cuid())
  firstName   String // Prénoms
  lastName    String // Nom
  company     String? // Entreprise
  phone       String? // Contacts
  email       String? // Adresse mail
  objet       String // Objet de visite
  details     String?       @db.Text
  visitedAt   DateTime      @default(now()) // Jour et heure de visite (auto)
  source      VisitorSource @default(QR) // QR (auto-enregistré) ou INTERNE (saisi par l'accueil)
  createdById Int? // Utilisateur ayant saisi (si source INTERNE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  createdBy User? @relation("VisitorCreatedBy", fields: [createdById], references: [id])

  @@index([visitedAt])
}

enum VisitorSource {
  QR
  INTERNE
}

// Objets de visite — liste paramétrable (gérée depuis le module Visiteurs).
model VisitObject {
  id        Int       @id @default(autoincrement())
  label     String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ── GESTION DES APPELS (entrants / sortants) ──────────────────────────────────

/// Journal des appels téléphoniques entrants et sortants. Rattachement
/// optionnel à un client ou un prospect existant (contexte), sinon coordonnées
/// libres (firstName/lastName/company/phone/email).
model PhoneCall {
  id          Int           @id @default(autoincrement())
  uuid        String        @unique @default(cuid())
  direction   CallDirection
  // Ligne téléphonique de l'entreprise utilisée pour passer/recevoir l'appel
  // (référentiel paramétrable `PhoneLine`, même principe que `Employee.poste`).
  ligne       String?
  firstName   String?
  lastName    String?
  company     String?
  phone       String
  email       String?
  objet       String // Objet de l'appel
  details     String?       @db.Text
  duration    Int? // Durée en minutes
  status      CallStatus    @default(ABOUTI)
  calledAt    DateTime      @default(now())
  clientId    Int?
  prospectId  Int?
  createdById Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  client    Client?   @relation(fields: [clientId], references: [id])
  prospect  Prospect? @relation(fields: [prospectId], references: [id])
  createdBy User?     @relation("PhoneCallCreatedBy", fields: [createdById], references: [id])

  @@index([calledAt])
  @@index([clientId])
  @@index([prospectId])
}

enum CallDirection {
  ENTRANT
  SORTANT
}

enum CallStatus {
  ABOUTI
  MANQUE
  OCCUPE
  MESSAGE_LAISSE
}

// Lignes téléphoniques de l'entreprise — liste paramétrable (même principe que
// JobPosition) alimentant le champ « Ligne téléphonique » du formulaire d'appel.
model PhoneLine {
  id        Int       @id @default(autoincrement())
  label     String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ── ÉVALUATION & GESTION DES PERFORMANCES (Module 14) ─────────────────────────

// Référentiel « Unité » des KPI (liste paramétrable). Même principe que
// JobPosition : alimente le sélecteur « Unité » du formulaire KPI (avec création
// à la volée). La valeur retenue est stockée en clair dans `KpiDefinition.unit`.
model KpiUnit {
  id        Int       @id @default(autoincrement())
  label     String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Catalogue configurable des indicateurs de performance (KPI). Un KPI est soit
// calculé automatiquement à partir d'une source de données de l'application
// (ventes, commissions, encaissements, activités CRM, assiduité…), soit saisi
// manuellement (source = MANUAL). `direction` indique si une valeur plus élevée
// (HIGHER_BETTER) ou plus basse (LOWER_BETTER) est meilleure.
model KpiDefinition {
  id            Int          @id @default(autoincrement())
  uuid          String       @unique @default(cuid())
  code          String       @unique // slug stable, ex: SALES_AMOUNT
  label         String
  category      String? // regroupement d'affichage
  source        KpiSource    @default(MANUAL)
  metric        KpiMetric    @default(MANUAL_VALUE)
  unit          String? // ex: FCFA, %, nb, h
  direction     KpiDirection @default(HIGHER_BETTER)
  defaultTarget Decimal?     @db.Decimal(15, 2)
  description   String?      @db.Text
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  weightLines     PerformanceWeightLine[]
  objectives      PerformanceObjective[]
  evaluationLines PerformanceEvaluationLine[]
}

enum KpiSource {
  SALES // Ventes / conventions (Convention.agentId = Employee.userId)
  COMMISSIONS // Commissions encaissées (Commission.userId)
  ACCOUNTING // Encaissements (Payment sur factures des conventions de l'agent)
  CRM // Activités CRM traitées (CrmActivity.userId)
  PROSPECTS // Prospection (Prospect.assignedToId = Employee.userId)
  ATTENDANCE // Assiduité / pointage (AttendanceRecord.employeeId)
  LEAVE // Congés / absences (LeaveRequest.employeeId)
  PROJECT // Projets (niveau service — pas d'attribution par utilisateur)
  SOCIAL // Réseaux sociaux / site web (SocialPublication.authorId, SocialPlatform.responsibleId)
  IT_INNOVATION // Innovations IT (ItInnovation.employeeId)
  MANUAL // Saisie manuelle par l'évaluateur
}

enum KpiMetric {
  SALES_COUNT
  SALES_AMOUNT
  RESILIATION_COUNT
  COMMISSION_AMOUNT
  ENCAISSEMENT_AMOUNT
  RECOVERY_RATE
  CRM_ACTIVITIES_DONE
  CRM_VISITS
  CRM_CALLS
  PROSPECT_CONVERSION_RATE
  NEW_POTENTIAL_PROSPECTS
  SOCIAL_PUBLICATIONS_COUNT
  SOCIAL_VIEWS
  SOCIAL_INTERACTIONS
  SOCIAL_FOLLOWERS_GROWTH
  ATTENDANCE_RATE
  OVERTIME_HOURS
  ABSENCE_DAYS
  LATE_EARLY_DEPARTURE_HOURS
  IT_INNOVATIONS_IMPLEMENTED
  MANUAL_VALUE
}

enum KpiDirection {
  HIGHER_BETTER
  LOWER_BETTER
}

// Profil de pondération des KPI par poste. Chaque poste peut valoriser
// différemment les KPI (somme des poids ramenée à 100 % au calcul du score).
model PerformanceWeightProfile {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(cuid())
  poste     String
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lines PerformanceWeightLine[]

  @@index([poste])
}

model PerformanceWeightLine {
  id              Int     @id @default(autoincrement())
  profileId       Int
  kpiDefinitionId Int
  weight          Decimal @db.Decimal(6, 2) // poids relatif du KPI dans le profil

  profile       PerformanceWeightProfile @relation(fields: [profileId], references: [id])
  kpiDefinition KpiDefinition            @relation(fields: [kpiDefinitionId], references: [id])

  @@index([profileId])
  @@index([kpiDefinitionId])
}

// Objectif (annuel ou trimestriel) fixé à un collaborateur. Si `kpiDefinitionId`
// est renseigné et `measureType = AUTO`, la progression est mesurée à partir des
// données de l'application ; sinon la progression est saisie manuellement.
model PerformanceObjective {
  id              Int             @id @default(autoincrement())
  uuid            String          @unique @default(cuid())
  // Cible de l'objectif : soit un employé précis (`employeeId`), soit un poste
  // (`poste`) — auquel cas il s'applique à tous les employés occupant ce poste.
  // Invariant applicatif : exactement l'un des deux est renseigné.
  employeeId      Int?
  poste           String?
  cycleType       PerfCycleType   @default(ANNUEL)
  year            Int
  quarter         Int? // 1–4 pour un objectif trimestriel, null si annuel
  title           String
  description     String?         @db.Text
  weight          Decimal         @default(1) @db.Decimal(6, 2)
  targetValue     Decimal?        @db.Decimal(15, 2)
  unit            String?
  kpiDefinitionId Int?
  measureType     PerfMeasureType @default(MANUAL)
  progress        Int             @default(0) // 0–100 %
  status          ObjectiveStatus @default(EN_COURS)
  createdById     Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  employee         Employee?      @relation(fields: [employeeId], references: [id])
  kpiDefinition    KpiDefinition? @relation(fields: [kpiDefinitionId], references: [id])
  linkedActivities CrmActivity[]

  @@index([employeeId])
  @@index([poste])
  @@index([kpiDefinitionId])
}

enum PerfCycleType {
  ANNUEL
  TRIMESTRIEL
}

enum PerfMeasureType {
  AUTO
  MANUAL
}

enum ObjectiveStatus {
  EN_COURS
  ATTEINT
  PARTIEL
  NON_ATTEINT
  ANNULE
}

// Fiche d'évaluation d'un collaborateur sur un cycle (annuel/trimestriel).
// Validation électronique à 3 niveaux : responsable → collaborateur → Direction.
model PerformanceEvaluation {
  id                  Int              @id @default(autoincrement())
  uuid                String           @unique @default(cuid())
  reference           String           @unique // Ex: EVA-2026-0001
  employeeId          Int
  cycleType           PerfCycleType    @default(ANNUEL)
  year                Int
  quarter             Int?
  evaluatorId         Int? // User responsable (évaluateur)
  globalScore         Decimal?         @db.Decimal(6, 2) // note globale 0–100
  status              EvaluationStatus @default(BROUILLON)
  // Signatures électroniques (horodatage + identifiant utilisateur signataire)
  managerSignedById   Int?
  managerSignedAt     DateTime?
  employeeSignedById  Int?
  employeeSignedAt    DateTime?
  directionSignedById Int?
  directionSignedAt   DateTime?
  refusedById         Int?
  refusedAt           DateTime?
  refusalReason       String?          @db.Text
  strengths           String?          @db.Text
  areasToImprove      String?          @db.Text
  comments            String?          @db.Text
  createdById         Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  employee  Employee                    @relation(fields: [employeeId], references: [id])
  evaluator User?                       @relation("PerfEvaluator", fields: [evaluatorId], references: [id])
  lines     PerformanceEvaluationLine[]
  plans     ProgressPlan[]

  @@index([employeeId])
  @@index([evaluatorId])
}

enum EvaluationStatus {
  BROUILLON
  SOUMISE
  VALIDEE_RESPONSABLE
  VALIDEE_COLLABORATEUR
  VALIDEE_DIRECTION
  CLOTUREE
  REFUSEE
}

model PerformanceEvaluationLine {
  id              Int      @id @default(autoincrement())
  evaluationId    Int
  objectiveId     Int?
  kpiDefinitionId Int?
  label           String
  weight          Decimal  @default(1) @db.Decimal(6, 2)
  targetValue     Decimal? @db.Decimal(15, 2)
  actualValue     Decimal? @db.Decimal(15, 2)
  score           Decimal? @db.Decimal(6, 2) // note de la ligne 0–100
  comment         String?  @db.Text

  evaluation    PerformanceEvaluation @relation(fields: [evaluationId], references: [id])
  kpiDefinition KpiDefinition?        @relation(fields: [kpiDefinitionId], references: [id])

  @@index([evaluationId])
  @@index([kpiDefinitionId])
}

// Plan de progrès (actions + besoins de formation) rattaché à une évaluation.
model ProgressPlan {
  id            Int                @id @default(autoincrement())
  uuid          String             @unique @default(cuid())
  evaluationId  Int?
  employeeId    Int
  title         String
  actions       String?            @db.Text
  trainingNeeds String?            @db.Text
  dueDate       DateTime?
  status        ProgressPlanStatus @default(EN_COURS)
  followUpNotes String?            @db.Text
  createdById   Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  evaluation PerformanceEvaluation? @relation(fields: [evaluationId], references: [id])
  employee   Employee               @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([evaluationId])
}

enum ProgressPlanStatus {
  EN_COURS
  REALISE
  ABANDONNE
}

// Classement figé (historique) sur une période. Les classements sont calculés à
// la volée par défaut ; un snapshot archive un classement daté.
model PerformanceRankingSnapshot {
  id            Int               @id @default(autoincrement())
  uuid          String            @unique @default(cuid())
  periodType    RankingPeriodType
  periodStart   DateTime
  periodEnd     DateTime
  basis         RankingBasis      @default(KPI)
  generatedById Int?
  createdAt     DateTime          @default(now())

  generatedBy User?                     @relation("PerfRankingGeneratedBy", fields: [generatedById], references: [id])
  entries     PerformanceRankingEntry[]

  @@index([periodType, periodStart])
}

model PerformanceRankingEntry {
  id         Int     @id @default(autoincrement())
  snapshotId Int
  employeeId Int
  score      Decimal @db.Decimal(8, 2)
  rank       Int

  snapshot PerformanceRankingSnapshot @relation(fields: [snapshotId], references: [id])
  employee Employee                   @relation(fields: [employeeId], references: [id])

  @@index([snapshotId])
  @@index([employeeId])
}

enum RankingPeriodType {
  SEMAINE
  MOIS
  TRIMESTRE
  SEMESTRE
  ANNEE
}

enum RankingBasis {
  KPI
  EVALUATION
}

// ── RÉSEAUX SOCIAUX & PLATEFORMES WEB (Module 15) ──────────────────────────
// Suivi manuel de l'activité digitale de l'entreprise : comptes réseaux
// sociaux et site web, publications/articles, relevés d'abonnés. Alimente le
// tableau de bord du module et le catalogue KPI (source SOCIAL).

model SocialPlatform {
  id            Int                @id @default(autoincrement())
  uuid          String             @unique @default(cuid())
  name          String
  type          SocialPlatformType
  url           String?
  // Collaborateur responsable du compte/de la plateforme — sert de base
  // d'attribution au KPI SOCIAL_FOLLOWERS_GROWTH (croissance d'abonnés).
  responsibleId Int?
  isActive      Boolean            @default(true)
  notes         String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  responsible       User?                    @relation("SocialPlatformResponsible", fields: [responsibleId], references: [id])
  publications      SocialPublication[]
  followerSnapshots SocialFollowerSnapshot[]
}

enum SocialPlatformType {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TIKTOK
  X_TWITTER
  YOUTUBE
  WEBSITE
  AUTRE
}

model SocialPublication {
  id                Int                   @id @default(autoincrement())
  uuid              String                @unique @default(cuid())
  platformId        Int
  type              SocialPublicationType @default(PUBLICATION)
  title             String
  publishedAt       DateTime
  url               String?
  viewsCount        Int                   @default(0)
  interactionsCount Int                   @default(0)
  // Auteur / responsable de la publication — base d'attribution des KPI
  // SOCIAL_PUBLICATIONS_COUNT, SOCIAL_VIEWS, SOCIAL_INTERACTIONS.
  authorId          Int?
  notes             String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  platform    SocialPlatform @relation(fields: [platformId], references: [id])
